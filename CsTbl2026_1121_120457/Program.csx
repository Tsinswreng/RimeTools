Z("㱕", a=>{
	a.PolyMc("kyoi");
	a.Ptl(b=>{
		b.聲符("歸");
		b.諧聲域("KUI");
		b.反切("舉韋");
		b.中古地位("見微合三平");
		b.切拼("kuj");
		b.上古音參考("kui");
		b.考釋("·歸，《說文》：「歸，女嫁也。从止，从婦省，𠂤聲。」甲骨文作「⿰𠂤帚」，裘錫圭先生以爲从「𠂤」、「帚(彗)」聲，其「帚」讀｛彗｝音（說見：裘錫圭《殷墟甲骨文“彗”字補說》、《説从“𡴎”聲的从“貝”與从“辵”之字》），然「歸」「彗」聲韻俱遠、不諧，其說恐非。待考。");
	});
	a.廣韻意("籀文");
});
