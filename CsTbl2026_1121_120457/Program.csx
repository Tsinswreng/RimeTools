Z("豰", a=>{
	a.PolyMc("bruk");
	a.PolyMc("huk");
	a.PolyMc("tuk");
	a.DtOc("pɢroːg");
	a.DtOc("broːg");
	a.DtOc("qʰoːg");
	a.Ptl(b=>{
		b.聲符("豖");
		b.諧聲域("TOK");
		b.反切("丁木");
		b.中古地位("端屋一入");
		b.切拼("touk");
		b.上古音參考("tˤok");
		b.考釋("·豰，本作「𣫔」，後訛與呼木切之「豰」同形；見蒲角切之「豰」。");
	});
	a.Ptl(b=>{
		b.聲符("𡉉");
		b.諧聲域("KOK");
		b.反切("呼木");
		b.中古地位("曉屋一入");
		b.切拼("houk");
		b.上古音參考("hˤok");
	});
	a.Ptl(b=>{
		b.聲符("𡉉");
		b.諧聲域("ɁOK");
		b.反切("呼木");
		b.中古地位("曉屋一入");
		b.切拼("houk");
		b.上古音參考("hˤok");
	});
	a.Ptl(b=>{
		b.聲符("𡉉");
		b.諧聲域("KOK");
		b.反切("蒲(評)角");
		b.中古地位("曉覺二入");
		b.切拼("hoeuk");
		b.上古音參考("hrˤok");
		b.考釋("·豰，小豬，《說文》：「豰，小豚也。从豕，㱿聲。」大徐本《說文》步角切；小徐本《說文》丁毒反。小徐本《說文》之「丁毒反」爲因「豰」與「豖」聲之「𣫔」訛形混淆而誤置的讀音，不論。《切韻》系韻書或讀並母蒲角反，然此音聲母與「㱿」聲不合，疑早期韻書反切上字本作「𧦝」（如《名義》作「𧦝卜反」，顧野王《玉篇》蓋亦如此）、讀曉母，後訛作「評」，遂誤讀有並母之音。");
	});
	a.Ptl(b=>{
		b.聲符("𡉉");
		b.諧聲域("ɁOK");
		b.反切("蒲(評)角");
		b.中古地位("曉覺二入");
		b.切拼("hoeuk");
		b.上古音參考("hrˤok");
		b.考釋("·豰，小豬，《說文》：「豰，小豚也。从豕，㱿聲。」大徐本《說文》步角切；小徐本《說文》丁毒反。小徐本《說文》之「丁毒反」爲因「豰」與「豖」聲之「𣫔」訛形混淆而誤置的讀音，不論。《切韻》系韻書或讀並母蒲角反，然此音聲母與「㱿」聲不合，疑早期韻書反切上字本作「𧦝」（如《名義》作「𧦝卜反」，顧野王《玉篇》蓋亦如此）、讀曉母，後訛作「評」，遂誤讀有並母之音。");
	});
	a.廣韻意("獸名似豹而小食獼猴又名黃𦝫案說文作㺉犬屬𦝫巳上黃𦝫已下黑食母猴");
	a.廣韻意("說文云小豚也");
});
