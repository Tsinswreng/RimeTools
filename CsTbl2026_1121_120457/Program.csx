Z("逄", a=>{
	a.PolyMc("brung");
	a.DtOc("broːŋ");
	a.Ptl(b=>{
		b.聲符("丰");
		b.諧聲域("POŊ");
		b.反切("薄江");
		b.中古地位("並江二平");
		b.切拼("boeung");
		b.上古音參考("brˤoŋ");
		b.考釋("·逄，俗書「夆」作「夅」，「逄」「逢」本一字，後分化爲二（說見：顏師古《匡謬正俗》卷八、張涌泉《試論漢語俗字研究的意義》等）。幫組字如「胮」「𩐨」等皆如此（也參：劉嬌《根據馬王堆帛書〈天文氣象雜占〉中的圖像資料校讀相關傳世古書札記二則》第一則），非所謂「夅」聲字。");
	});
	a.廣韻意("姓也出北海左傳齊有逄丑父");
});
