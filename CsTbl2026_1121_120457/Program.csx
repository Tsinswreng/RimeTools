		b.諧聲域("NO");
		b.反切("奴亂");
		b.中古地位("泥寒合一去");
		b.切拼("nwanh");
		b.上古音參考("nˤonh");
	});
	a.Ptl(b=>{
		b.聲符("需");
		b.諧聲域("NON");
		b.反切("奴亂");
		b.中古地位("泥寒合一去");
		b.切拼("nwanh");
		b.上古音參考("nˤonh");
	});
	a.Ptl(b=>{
		b.聲符("需");
		b.諧聲域("NO");
		b.反切("而兖");
		b.中古地位("日仙合三上");
		b.切拼("njwienq");
		b.上古音參考("nonʔ");
		b.考釋("·耎，《說文·大部》：「耎，稍前大也。从大、而聲。讀若畏偄。」其說非是，「需」古音侯部，「而」古音之部，斷不可諧。鄭張尚芳《上古音系》：「耎，《說文》『而』聲，疑耎𦓔皆需(濡)之隸變異構。」其說是。「需」「耎」本一字，後分化爲兩字，段玉裁云：「古凡耎聲字皆在十四部；需聲字皆在四部。後人多亂之。」是傳世諧聲系統中「需」聲字多在侯部-O、「耎」聲字多在合口元部-ON；言「後人多亂之」則非，兩字本就同源，早期無別，如秦簡中「耎」亦讀侯部詞：①空地。讀爲｛壖｝。龍崗秦簡：「諸禁苑爲耎(壖)27」②沾漬。讀爲｛濡｝。睡虎地秦簡《封診式》：「相耎(濡)。57」自漢代有所分工而已。");
	});
	a.Ptl(b=>{
		b.聲符("需");
		b.諧聲域("NON");
		b.反切("而兖");
		b.中古地位("日仙合三上");
		b.切拼("njwienq");
		b.上古音參考("nonʔ");
		b.考釋("·耎，《說文·大部》：「耎，稍前大也。从大、而聲。讀若畏偄。」其說非是，「需」古音侯部，「而」古音之部，斷不可諧。鄭張尚芳《上古音系》：「耎，《說文》『而』聲，疑耎𦓔皆需(濡)之隸變異構。」其說是。「需」「耎」本一字，後分化爲兩字，段玉裁云：「古凡耎聲字皆在十四部；需聲字皆在四部。後人多亂之。」是傳世諧聲系統中「需」聲字多在侯部-O、「耎」聲字多在合口元部-ON；言「後人多亂之」則非，兩字本就同源，早期無別，如秦簡中「耎」亦讀侯部詞：①空地。讀爲｛壖｝。龍崗秦簡：「諸禁苑爲耎(壖)27」②沾漬。讀爲｛濡｝。睡虎地秦簡《封診式》：「相耎(濡)。57」自漢代有所分工而已。");
	});
	a.廣韻意("敬也亦弱也");
	a.廣韻意("偄弱也奴亂切五");
});
