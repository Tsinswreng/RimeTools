	a.Ptl(b=>{
		b.聲符("示");
		b.諧聲域("TI");
		b.反切("巨支");
		b.中古地位("羣支開三A平");
		b.切拼("gie");
		b.上古音參考("ɡe");
		b.考釋("·示，「示」之聲域難定，考古似應歸KI（見組脂部），如：①郭店簡《緇衣》引《詩》：「人之好我，旨我周行。」「旨」今本作「示」。文字材料多見「示」「旨」互用者。②臺北樂從堂藏西漢青銅馬，於鬃毛末端兩側的馬頸與脊背相接處有一「示」字，董珊讀爲｛鬐｝*ɡri（見：董珊：《樂從堂藏銅馬式考》）。然「示」傳世音船母神至切，與KI似不合（白-沙構擬*s-ɡ->中古船，難信）；｛視｝古文字材料或作表意字、或加注「氐」TI聲，此亦非見組，張富海據歸端組脂部TI（可參：張富海《據古文字論“氏”、“視”等字的上古聲母》）。｛視｝*dih之古音雖鑿，然傳世之「視」字恐非一般「示」聲字，未必能論及「示」之音。俟考。");
	});
	a.Ptl(b=>{
		b.聲符("示");
		b.諧聲域("KE");
		b.反切("巨支");
		b.中古地位("羣支開三A平");
		b.切拼("gie");
		b.上古音參考("ɡe");
		b.考釋("·示，「示」之聲域難定，考古似應歸KI（見組脂部），如：①郭店簡《緇衣》引《詩》：「人之好我，旨我周行。」「旨」今本作「示」。文字材料多見「示」「旨」互用者。②臺北樂從堂藏西漢青銅馬，於鬃毛末端兩側的馬頸與脊背相接處有一「示」字，董珊讀爲｛鬐｝*ɡri（見：董珊：《樂從堂藏銅馬式考》）。然「示」傳世音船母神至切，與KI似不合（白-沙構擬*s-ɡ->中古船，難信）；｛視｝古文字材料或作表意字、或加注「氐」TI聲，此亦非見組，張富海據歸端組脂部TI（可參：張富海《據古文字論“氏”、“視”等字的上古聲母》）。｛視｝*dih之古音雖鑿，然傳世之「視」字恐非一般「示」聲字，未必能論及「示」之音。俟考。");
	});
	a.Ptl(b=>{
		b.聲符("示");
		b.諧聲域("TI");
		b.反切("神至");
		b.中古地位("船脂開三去");
		b.切拼("zjih");
		b.上古音參考("dih");
	});
	a.Ptl(b=>{
		b.聲符("示");
		b.諧聲域("KE");
		b.反切("神至");
		b.中古地位("船脂開三去");
		b.切拼("zjih");
		b.上古音參考("dih");
	});
	a.廣韻意("上同見周禮本又時至切");
	a.廣韻意("垂示神至切五");
});
