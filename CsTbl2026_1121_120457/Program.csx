Z("攋", a=>{
	a.PolyMc("lat");
	a.DtOc("raːds");
	a.DtOc("reːdʔ");
	a.DtOc("raːd");
	a.Ptl(b=>{
		b.聲符("剌");
		b.諧聲域("RAT");
		b.反切("盧達");
		b.中古地位("來末開一入");
		b.切拼("lat");
		b.上古音參考("rˤat");
		b.考釋("·剌，《說文》：「剌，戾也。从束从刀。刀者，剌之也。」其說非是。古文字「𣏮」象禾幹上著口形，指示禾稈，是｛䅀｝*rat之表意字（說見裘錫圭《甲骨文中所見的商代農業》），此字爲「剌」字之聲首。");
	});
	a.廣韻意("撥攋手披也");
});
Z("攍", a=>{
	a.PolyMc("jeng");
	a.DtOc("leŋ");
	a.Ptl(b=>{
		b.聲符("嬴");
		b.諧聲域("LEŊ");
		b.反切("以成");
		b.中古地位("以清開三平");
		b.切拼("jiaeng");
		b.上古音參考("leŋ");
		b.考釋("·嬴，《說文》：「嬴，少昊氏之姓也。从女，羸省聲。」·贏，《說文》：「贏，有餘賈利也。從貝，𣎆聲。」段玉裁注：「按惟『羸』『驘』字可云『𣎆』聲。『贏』字當云『從貝、𣎆』。𣎆者、多肉之獸也。故以會意。《女部》『嬴』當云『贏』省聲。今本多誤。以成切。十一部。」傳世「𣎆」聲諸字有兩類讀音：①來組歌部ROI；②以組耕部LEŊ，其得音來源不詳。今分爲兩聲系。");
	});
	a.廣韻意("擔也");
});
Z("攎", a=>{
	a.PolyMc("lo");
	a.DtOc("raː");
	a.Ptl(b=>{
		b.聲符("虍");
		b.諧聲域("RA");
		b.反切("落胡");
		b.中古地位("來模一平");
		b.切拼("lo");
		b.上古音參考("rˤa");
		b.考釋("·㭔，木名。《說文》：「㭔，木。出橐山。从木、乎聲。」段玉裁注：「《中山經》曰：『傅山西五十里曰橐山。其木多樗、多𣖾木。』按樗者㭔之誤。」《山海經·中山經》「樗」乃「㯉」之訛字，是「㭔」本又作「㯉」。");
	});
	a.Ptl(b=>{
		b.聲符("虍");
		b.諧聲域("PRA");
		b.反切("落胡");
		b.中古地位("來模一平");
		b.切拼("lo");
		b.上古音參考("rˤa");
		b.考釋("·㭔，木名。《說文》：「㭔，木。出橐山。从木、乎聲。」段玉裁注：「《中山經》曰：『傅山西五十里曰橐山。其木多樗、多𣖾木。』按樗者㭔之誤。」《山海經·中山經》「樗」乃「㯉」之訛字，是「㭔」本又作「㯉」。");
	});
	a.Ptl(b=>{
		b.聲符("虍");
		b.諧聲域("KLA");
		b.反切("落胡");
		b.中古地位("來模一平");
		b.切拼("lo");
		b.上古音參考("rˤa");
		b.考釋("·㭔，木名。《說文》：「㭔，木。出橐山。从木、乎聲。」段玉裁注：「《中山經》曰：『傅山西五十里曰橐山。其木多樗、多𣖾木。』按樗者㭔之誤。」《山海經·中山經》「樗」乃「㯉」之訛字，是「㭔」本又作「㯉」。");
	});
	a.廣韻意("攎斂");
});
