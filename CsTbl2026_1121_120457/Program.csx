		b.切拼("doung");
		b.上古音參考("lˤoŋ");
		b.考釋("·同，古文字「同」似筒形器（後加从「口」作「同」），爲｛筒｝的表意字；其有把手者作「用」（說見裘錫圭《甲骨文中的幾種樂器名稱——釋“庸”“豐”“鞀”》等）；鄔可晶指出「甬」很可能是從在「用」的豎畫上加弧筆或「▽」形的異體分化出來的（說見：鄔可晶《戰國時代寫法特殊的“曷”的字形分析，並說“𰕎”及其相關問題》）。「同」「用」「甬」諸字聲首皆來自“桶”之類的詞，故置於一處。·𪔝，蓋「𪔜」之訛字。");
	});
	a.廣韻意("熱氣烔烔出字林");
});
Z("烕", a=>{
	a.PolyMc("hyet");
	a.BsOc(b=>{
		b.Oc("*m̥et");
		b.Gloss("extinguish, destroy");
	});
	a.SchOc("hmet");
	a.SchOc("hmat");
	a.SchOc("m̥et");
	a.MsoegOc("m̥ɛt");
	a.StaOc("smet");
	a.DtOc("hmed");
	a.Ptl(b=>{
		b.聲符("戌");
		b.諧聲域("MIT");
		b.反切("許劣");
		b.中古地位("曉薛合三B入");
		b.切拼("huet");
		b.上古音參考("m̥et");
		b.考釋("·𣧡，「𣧵」之訛字，「戌」聲。·烕，《說文》：「烕，滅也。从火、戌。火死於戌，陽氣至戌而盡。《詩》曰：赫赫宗周，褒似烕之。」《釋文》引作「從火，戌聲。」所謂「火」「戌」會意不可信；清人或以爲「戌」亦聲。林沄先生以爲其「戌」乃古文字“扇”形之訛變（說見：林沄《先秦古文字中待探索的偏旁》）。白-沙信從「戌」聲，旁證以Ahom語（一種侗台語）的“狗年”叫/mit/。今從白-沙。");
	});
	a.Ptl(b=>{
		b.聲符("戌");
		b.諧聲域("MET");
		b.反切("許劣");
		b.中古地位("曉薛合三B入");
		b.切拼("huet");
		b.上古音參考("m̥et");
		b.考釋("·𣧡，「𣧵」之訛字，「戌」聲。·烕，《說文》：「烕，滅也。从火、戌。火死於戌，陽氣至戌而盡。《詩》曰：赫赫宗周，褒似烕之。」《釋文》引作「從火，戌聲。」所謂「火」「戌」會意不可信；清人或以爲「戌」亦聲。林沄先生以爲其「戌」乃古文字“扇”形之訛變（說見：林沄《先秦古文字中待探索的偏旁》）。白-沙信從「戌」聲，旁證以Ahom語（一種侗台語）的“狗年”叫/mit/。今從白-沙。");
	});
	a.廣韻意("滅也");
});
