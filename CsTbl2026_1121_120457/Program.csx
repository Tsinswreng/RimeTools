Z("茍", a=>{
	a.PolyMc("kik");
	a.PolyMc("kik");
	a.DtOc("kɯg");
	a.Ptl(b=>{
		b.聲符("茍");
		b.諧聲域("—");
		b.反切("紀力");
		b.中古地位("見職開三入");
		b.切拼("kyk");
		b.考釋("·茍，《說文》：「茍，自急敕也。从羊省，从包省。从口，口猶愼言也。从羊，羊與義、善、美同意。凡茍之屬皆从茍。𠷜，古文羊不省。」按《說文》「自急敕也」之訓語可分兩部分：在“急”的意義上此「茍」與「亟」、「悈」、「棘」是一詞異體；在“敕”的意義上與｛誡｝同源；且這兩個意義在語源上是相關的。其訓皆與上古見系職部詞有關，是許慎讀「茍」爲職部音，中古字韻書得之。秦漢文字「茍」「亟」形近混淆（可參：邊田剛《漢語史視角下的〈淮南子〉校釋新證》》），許音蓋本於此，鄔可晶說。");
	});
});
