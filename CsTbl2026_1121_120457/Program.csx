Z("蘮", a=>{
	a.PolyMc("kied");
	a.SchOc("kats");
	a.DtOc("krads");
	a.Ptl(b=>{
		b.聲符("㓹");
		b.諧聲域("KRAT");
		b.反切("居例");
		b.中古地位("見祭開三B去");
		b.切拼("kyejh");
		b.上古音參考("krath");
		b.考釋("·㓹，大徐本《說文·艸部》：「銳，芒也。从金，兌聲。㓹，籀文銳从厂、剡。」小徐本作「㓹，籀文銳從剡。」段玉裁注：「从剡、厂聲。」傳世「㓹」聲字多在居例切，推及上古音開口月部，這種「㓹」已見於戰國楚簡，其讀皆在月部、與傳世音相合，其例如：上博竹書《周易》簡49：「㓹(列)丌(其)胤。」今本《周易·艮卦》作「列其夤」。戰國文字「㓹」可能源於西周金文「𪟔」〔《集成》04484〕，與「徹」等字之聲首實出一源，蓋形聲皆已分化。然古文字中的「㓹」古音與「銳」聲不近，許慎《說文》何以謂「㓹」「銳」異體費解，李春桃《傳抄古文綜合研究》謂傳抄古文之「㓹」乃「釞」之流變，俟考。");
	});
	a.廣韻意("蘮蒘似芹");
});
