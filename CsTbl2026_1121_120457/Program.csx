Z("謋", a=>{
	a.PolyMc("hruak");
	a.SchOc("hrâk");
	a.DtOc("qʰʷraːg");
	a.Ptl(b=>{
		b.聲符("虢");
		b.諧聲域("WAK");
		b.反切("虎伯");
		b.中古地位("曉陌合二入");
		b.切拼("hwaek");
		b.上古音參考("w̥rˤak");
		b.考釋("·諕，此字音合口陌韻，非「虎」聲，疑爲「虢」省聲。又作「謋」。·謋，可能是从「磔」省（或徑从「桀」）、「諕」省聲，《莊子》「謋然已解」成玄英疏：「謋然，骨肉離之聲也。」是「謋」有“分離”義，該詞與訓“裂”之｛捇｝同源，「磔」亦有“裂”義，故「謋」可以「磔」省爲義符。此省之又省，頗爲怪異，備此待考。");
	});
	a.廣韻意("謋然虎伯切八");
});
