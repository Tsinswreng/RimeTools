Z("嶭", a=>{
	a.PolyMc("ngat");
	a.PolyMc("nget");
	a.DtOc("ŋaːd");
	a.DtOc("ŋeːd");
	a.Ptl(b=>{
		b.聲符("𬔖¹");
		b.諧聲域("ŊAT");
		b.反切("五割");
		b.中古地位("疑末開一入");
		b.切拼("ngat");
		b.上古音參考("ŋˤat");
		b.考釋("·枿，《爾雅》：「枿，餘也。」清人多已指出其「卉」乃「𦍐」之變體。桂馥《義證》：「『枿』爲『㮆』之變體。」徐灝《箋》：「『枿』者，『㮆』之譌體。」《說文》：「𣡌，伐木餘也。从木、獻聲。《商書》曰：『若顚木之有㽕𣡌。』櫱，𣡌或从木、辥聲。𣎴，古文𣡌从木，無頭。㮆，亦古文𣡌。」「𦍐」亦「𬔖」之變體，故置於此。");
	});
	a.Ptl(b=>{
		b.聲符("𬔖¹");
		b.諧聲域("ŊƏT");
		b.反切("五割");
		b.中古地位("疑末開一入");
		b.切拼("ngat");
		b.上古音參考("ŋˤat");
		b.考釋("·枿，《爾雅》：「枿，餘也。」清人多已指出其「卉」乃「𦍐」之變體。桂馥《義證》：「『枿』爲『㮆』之變體。」徐灝《箋》：「『枿』者，『㮆』之譌體。」《說文》：「𣡌，伐木餘也。从木、獻聲。《商書》曰：『若顚木之有㽕𣡌。』櫱，𣡌或从木、辥聲。𣎴，古文𣡌从木，無頭。㮆，亦古文𣡌。」「𦍐」亦「𬔖」之變體，故置於此。");
	});
	a.Ptl(b=>{
		b.聲符("𬔖¹");
		b.諧聲域("ŊAT");
		b.反切("五結");
		b.中古地位("疑屑開四入");
		b.切拼("nget");
	});
	a.Ptl(b=>{
		b.聲符("𬔖¹");
		b.諧聲域("ŊƏT");
		b.反切("五結");
		b.中古地位("疑屑開四入");
		b.切拼("nget");
	});
	a.廣韻意("五割切又五結切十三");
	a.廣韻意("巀嶭又五割切");
});
