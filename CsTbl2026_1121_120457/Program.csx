		b.上古音參考("ɡˤəm");
		b.考釋("·𢎘，《說文》裡的作爲聲符的「𢎘」來源駁雜：①傳世乎感切之「𢎘」，劉釗謂爲「圅」之截省分化字（說見：劉釗《古文字構形研究》），《說文》以「圅」爲「𢎘」聲，然「圅」實爲整體表意字，可見傳世文字系統的「𢎘」確係自「圅」剝離而出，今據其說歸入「圅」聲系；②《說文》以「氾」「犯」爲「𢎘」聲，這種「𢎘」實來自古文字中跪坐人形（早期字形上有屮形），得音源頭待考，今歸「㔾」聲系。");
	});
	a.Ptl(b=>{
		b.聲符("圅");
		b.諧聲域("KƏM");
		b.反切("胡讒");
		b.中古地位("匣咸開二平");
		b.切拼("gheem");
		b.上古音參考("ɡrˤəm");
	});
	a.廣韻意("容也禮云席閒函丈");
	a.廣韻意("函谷關名又函書亦姓漢有豫章太守函熙又漢複姓漢末有黃門侍郎函治子覺又音含");
});
