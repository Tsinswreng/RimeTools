Z("䨁", a=>{
	a.PolyMc("myoh");
	a.Ptl(b=>{
		b.聲符("敄");
		b.諧聲域("MU");
		b.反切("亡遇");
		b.中古地位("明虞三去");
		b.切拼("muoh");
		b.上古音參考("m(r)oh");
		b.考釋("·敄，《說文》：「敄，彊也。从攴、矛聲。」許慎謂「矛」聲，從出土古文字材料看，其說不確。西周金文見「敄」字，其左旁所从像人披髮之形而非「矛」字，此當是｛𩭾｝之初文（參考：李學勤《〈古韻通曉〉簡評》、陳英傑《談金文中的“敄”字及其相關問題》）。何九盈把「敄」作爲獨立的聲符，歸於侯部，至確。");
	});
	a.Ptl(b=>{
		b.聲符("敄");
		b.諧聲域("MO");
		b.反切("亡遇");
		b.中古地位("明虞三去");
		b.切拼("muoh");
		b.上古音參考("m(r)oh");
		b.考釋("·敄，《說文》：「敄，彊也。从攴、矛聲。」許慎謂「矛」聲，從出土古文字材料看，其說不確。西周金文見「敄」字，其左旁所从像人披髮之形而非「矛」字，此當是｛𩭾｝之初文（參考：李學勤《〈古韻通曉〉簡評》、陳英傑《談金文中的“敄”字及其相關問題》）。何九盈把「敄」作爲獨立的聲符，歸於侯部，至確。");
	});
	a.廣韻意("雞雛");
});
