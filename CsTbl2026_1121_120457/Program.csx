Z("嶧", a=>{
	a.TswgOcModed("lak");
	a.PolyMc("jek");
	a.SchOc("lak");
	a.DtOc("laːg");
	a.Ptl(b=>{
		b.聲符("睪");
		b.諧聲域("LAK");
		b.反切("羊益");
		b.中古地位("以昔開三入");
		b.切拼("jiaek");
		b.上古音參考("lak");
		b.考釋("·睪，《說文》：「睪，目視也。从橫目，从幸。令吏將目捕罪人也。」其說不可信。古文字有一字象兩手脫離桎梏之形、爲｛釋｝*l̥ak之表意字（見：裘錫圭《說殷墟卜辭的“奠”——試論商人處置附屬者的一種方法》），此即「睪」聲諸字聲首。");
	});
	a.廣韻意("山名在魯");
});
