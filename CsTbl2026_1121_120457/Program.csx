Z("㚖", a=>{
	a.PolyMc("chjek");
	a.PolyMc("kaux");
	a.Ptl(b=>{
		b.聲符("㚖");
		b.諧聲域("—");
		b.反切("古老");
		b.中古地位("見豪開一上");
		b.切拼("kawq");
		b.上古音參考("kˤuʔ");
		b.考釋("·《說文·亣部》：「㚖，大白、澤也。从大从白。古文以爲澤字。」段玉裁注：「古老切。二部。凡『皢皎皦皛皋縞晧杲』訓白之字皆同音部。但『㚖』字《廣韵》又昌石切，《集韵》又昌石、施隻二切，皆訓白澤。未詳其由。」古文字「𪰖」从「日」从「矢」，其形音蓋與｛射｝有關，古音在以組鐸部LAK，西周金文常見「亡(無)𪰖(斁)」一語。後上部變爲「白」而作「𬐇」（楚簡常見），《說文》所謂「古文以爲澤字」的「㚖」即此之流變。考《說文》謂其字从「大」从「白」而又爲「澤」，許慎似讀「㚖」見組幽部KU音，蓋其意屬｛皓｝、｛皋｝二詞說之——對傳世文字系統有深遠影響的許慎《說文》系統（音KU）與歷史文字史中真實的文字系統（音LAK）之不同可見一斑，前者有漢代小學家重構的成分，他們對文字音義的認識皆未必盡合乎文字史。《名義》公老反（當本自顧野王《玉篇》）、《切韻》古老反得許音。《切韻》系韻書又收昌石切一音，疑附會“鹽澤”之｛斥｝的音讀。");
	});
	a.廣韻意("大白澤也");
	a.廣韻意("白澤");
});
