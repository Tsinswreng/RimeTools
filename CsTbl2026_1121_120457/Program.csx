Z("𩿤", a=>{
	a.PolyMc("cret");
	a.Ptl(b=>{
		b.聲符("乚");
		b.諧聲域("TSET");
		b.反切("側八");
		b.中古地位("莊黠開二入");
		b.切拼("tsreet");
		b.上古音參考("tsrˤet");
		b.考釋("·札，《說文》：「札，牒也。从木，乙聲。」「乙」不諧上古精組TS-，「乙」聲非也。秦漢文字中多有一曲筆爲聲符者，其例如：①漢燕然山銘：「癹匈(凶)虐釓(截)海外。」（參考：史傑鵬《外蒙古杭愛山所發現的東漢〈燕然山銘〉釋文的幾個問題（下）》）②《隸釋》載《荆州刺史度尚碑》：「𠃲(截)彼海外。」是「釓」、「𠃲」（史傑鵬說即「釓」之變）、「札」諸字同聲首，今且立爲「乚」聲，古音精組月部TSET，來源待考。");
	});
	a.廣韻意("鳥雜蒼色");
});
