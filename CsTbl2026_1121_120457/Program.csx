Z("贅", a=>{
	a.PolyMc("cjyed");
	a.SchOc("tots");
	a.DtOc("kljods");
	a.DtOc("tjods");
	a.Ptl(b=>{
		b.聲符("贅");
		b.諧聲域("TOT");
		b.反切("之銳");
		b.中古地位("章祭合三去");
		b.切拼("tjwiejh");
		b.上古音參考("toth");
		b.考釋("·贅，《說文》：「贅，以物質錢。从敖、貝。敖者，猶放；貝，當復取之也。」所謂「敖」「貝」會意可疑，驗之秦漢文字，「贅」上部與「敖」有別。疑其左旁來源於戰國東土「叕」字之流變，混入秦文字系統。楚簡有从「叕」、「貝」、「攴」之字，當釋爲「贅」，包山楚簡：「Δ(贅)田。77」或是爲「贅」之來源。證據不足，未詳。·𠭥，之銳切之音蓋本于《說文》「讀若贅」，頗疑此音是「贅」上部之流形與「𢿆」在字形上相混後誤附的。此字又音雖遂切，見邃小韻。");
	});
	a.廣韻意("贅肉也又最也聚也又贅衣官名也之芮切二");
});
