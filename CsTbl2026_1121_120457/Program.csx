Z("掃", a=>{
	a.TswgOcModed("sˁuʔ");
	a.TswgOcModed("sˁus");
	a.PolyMc("sauh");
	a.PolyMc("saux");
	a.SchOc("sûʔ");
	a.SchOc("sûh");
	a.DtOc("suːʔ");
	a.DtOc("suːs");
	a.Ptl(b=>{
		b.聲符("掃");
		b.諧聲域("SU");
		b.反切("蘇老");
		b.中古地位("心豪開一上");
		b.切拼("sawq");
		b.上古音參考("sˤuʔ");
		b.考釋("·埽，大徐本《說文》：「埽，棄也。从土从帚。」小徐本作「從土，帚聲。」徐鍇曰「會意。」鈕樹玉《校錄》：「《繫傳》作『從土，帚聲。』然下有『鍇曰：會意。』蓋後人疑聲不近，幷去『聲』字。」其說是也，許慎《說文》本作「帚聲」。然「帚」聲母與「埽」不合，古文字學者多謂「帚」一形多用，既讀爲｛帚｝、又可讀爲｛掃｝。");
	});
	a.Ptl(b=>{
		b.聲符("掃");
		b.諧聲域("SU");
		b.反切("蘇到");
		b.中古地位("心豪開一去");
		b.切拼("sawh");
		b.上古音參考("sˤuh");
	});
	a.廣韻意("上同");
	a.廣韻意("上同");
});
