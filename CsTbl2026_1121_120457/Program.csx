Z("䒘", a=>{
	a.TswgOcModed("snuj");
	a.PolyMc("syi");
	a.Ptl(b=>{
		b.聲符("夊");
		b.諧聲域("NUI");
		b.反切("息遺");
		b.中古地位("心脂合三平");
		b.切拼("swi");
		b.上古音參考("snui");
		b.考釋("·夊，《說文·夊部》：「夊，行遲曳夊夊。象人兩脛有所躧也。」《毛詩·齊風·南山》「雄狐綏綏」，《玉篇》引《詩》云：「雄狐夊夊」。《詩攷補遺》引《詩說》：「有狐綏綏，《齊詩》作『有狐夊夊』。」此字傳世音泥組微部NUI，古文字「夊」似亦有此音。任鼎：「用夊大神。」董珊說讀爲｛綏｝，見：董珊《任鼎補釋——兼說亢鼎》。古文字材料中，「夊」亦讀端組歌部TOI，其證如：①楚簡文字中「夊」聲之「𪢶」讀爲｛錘｝（參考：白於藍.郭店楚墓竹簡考釋(四篇)》《說“綏”》、劉剛《楚銅貝“𪢶朱”的釋讀及相關問題》、李天虹《由嚴倉楚簡看戰國文字資料中“才”、“𪢶”兩字的釋讀》等）；②西周早期叔卣：「夊(垂)文遺工(功)。」（說見：董珊《新見魯叔四器銘文考釋》）③金文有人名用字作「⿰𠂤𪢶」，研究者或謂「𠂤」「𪢶」皆聲（或牽連「𠂤(次)」則非），按「𠂤」TUI與「𪢶」聲域接近，當是。端組歌部TOI之音與泥組微部NUI之音有別，但亦不遠。");
	});
	a.廣韻意("亦同");
});
