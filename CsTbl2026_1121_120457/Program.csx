Z("僿", a=>{
	a.PolyMc("sjih");
	a.DtOc("hljɯgs");
	a.Ptl(b=>{
		b.聲符("𡫳");
		b.諧聲域("SƏK");
		b.反切("式吏");
		b.中古地位("書之開三去");
		b.切拼("sjyh");
		b.考釋("·僿，《史記·高祖本紀》：「文之敝，小人以僿，故救僿莫若以忠。」裴駰集解：「僿，徐廣曰：一作『薄』。駰案：《史記音隱》曰：『僿音西志反。』鄭玄曰：『文，尊卑之差也。薄，苟習文法，無悃誠也。』」司馬貞索隱：「僿，鄭音先代反，鄒本作『薄』，音扶各反，本一作「僿」，而徐廣云一作「薄」，是本互不同也。裴又引音隱云：『僿音先志反』，僿、塞聲相近故也。蓋僿猶薄之義也。」《裴韻·至韻》息利反：「僿，〻猶細砕也。《史記》：小[人以]僿。」《廣韻》音式志切，此書母讀法與「塞」聲不密合。未詳。");
	});
	a.廣韻意("史記云小人以僿");
});
