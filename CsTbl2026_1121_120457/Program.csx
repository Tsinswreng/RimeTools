		b.諧聲域("NO");
		b.反切("而允");
		b.中古地位("日真合三上");
		b.切拼("njwinq");
		b.上古音參考("nunʔ");
	});
	a.Ptl(b=>{
		b.聲符("需");
		b.諧聲域("NON");
		b.反切("而允");
		b.中古地位("日真合三上");
