Z("敕", a=>{
	a.TswgOcModed("lʰrək");
	a.PolyMc("thrik");
	a.SchOc("r̥ək");
	a.MsoegOc("ʰɹək");
	a.StaOc("srʰək");
	a.DtOc("tʰɯg");
	a.Ptl(b=>{
		b.聲符("敕");
		b.諧聲域("LƏK");
		b.反切("恥力");
		b.中古地位("徹職開三入");
		b.切拼("trhyk");
		b.上古音參考("l̥rək");
		b.考釋("·敕，《說文》：「敕，誡也。臿地曰敕。从攴、束聲。」段玉裁《注》：「攴而收束之。二義皆於此會意。非束聲也。」朱駿聲《通訓定聲》、苗夔《聲訂》亦皆謂「束非聲」，是也。何琳儀《戰國古文字典》謂「敕」从「束」从「攴」、「束」亦聲，會“整飭”之意；所謂亦聲不可信。東周「敕」字从「柬」，如春秋晚期秦公簋：「邁民是㪝。」張世超等謂其「柬」乃「熏」之省形、乃以「柬(熏)」爲聲（說見：《金文形義通解》），不可信。西周金文中有字从「言」从「束」（或加點作「柬」），讀爲｛敕｝。其例如：大盂鼎：「敏誎(敕)罰訟。」大克鼎：「諫(敕)辥(乂)王家。」張富海以爲其字从「言」从「束」會以言語約束之意、本義與“告誡”有關，與从「束」从「攴」、以“整飭”爲本義的「敕」在構形本義上有別（說見：張富海《“敕”字補說》）。也許古文字「束」（或作「柬」）本身就另有個以組職部LƏK的讀音。");
	});
	a.廣韻意("誡也正也固也勞也理也書也急也今相承用勑勑本音賚恥力切十四");
});
