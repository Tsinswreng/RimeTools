Z("輇", a=>{
	a.PolyMc("chyen");
	a.PolyMc("zjyen");
	a.SchOc("tsʰon");
	a.DtOc("shlon");
	a.DtOc("djon");
	a.Ptl(b=>{
		b.聲符("全");
		b.諧聲域("TSON");
		b.反切("市緣");
		b.中古地位("常仙合三平");
		b.切拼("djwien");
		b.上古音參考("don");
		b.考釋("·輇，《說文》：「輇，藩車下庳輪也。從車，全聲。讀若饌。一曰無輻也。」其聲母與諧聲不合，待考。又作「輲」、「槫」、「膞」，《禮記·雜記上》：「載以輲車。」鄭玄注：「輲讀爲輇，或作槫。許氏《說文解字》曰：『有輻曰輪，無輻曰輇。』《周禮》又有蜃車，天子以載柩。蜃、輇聲相近，其制同乎！」陸德明釋文：「依注作『輇』及『槫』、同。市専反，又布轉反，注及下同。」原本《玉篇》引《禮記》作「載以輇車」。《周禮·冬官·旊人》：「器中膞，豆中縣。」鄭玄注：「膞讀如車輇之輇，既坿泥而轉其均，尌膞其側以擬度端其器也。」原本《玉篇》引《考工記》作「凡陶旊之事噐中輇」。");
	});
	a.廣韻意("上同");
});
