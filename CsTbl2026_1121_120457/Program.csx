Z("媣", a=>{
	a.PolyMc("kam");
	a.Ptl(b=>{
		b.聲符("染");
		b.諧聲域("NAM");
		b.反切("古三");
		b.中古地位("見談開一平");
		b.切拼("kam");
		b.考釋("·媣，諟也，又作「𡜉」。《說文》：「媣，諟也。从女、染聲。」《名義》辱紺反；《玉篇》而閃切；《王三》《裴韻》古三反；大徐本《說文》而琰切；《廣韻》古三、而琰二切；小徐本《說文》柔檢反。古三切之聲母與「染」聲不合，待考。");
	});
	a.Ptl(b=>{
		b.聲符("染");
		b.諧聲域("NAM");
		b.反切("而琰");
		b.中古地位("日鹽開三上");
		b.切拼("njiemq");
		b.上古音參考("namʔ");
		b.考釋("·染，《說文》：「染，以繒染爲色。从水，杂聲。」徐鍇曰：「《說文》無杂字。裴光遠云：『从木，木者所以染，桅、茜之屬也；从九，九者染之數也。』未知其審。」陶安、陳劍先生以爲「朵」聲（說見：陶安，陳劍《〈奏讞書〉校讀札記》），待考。");
	});
	a.廣韻意("媣媞也");
});
