	a.Ptl(b=>{
		b.聲符("隹²");
		b.諧聲域("WI");
		b.反切("以沼(小)");
		b.中古地位("以脂合三上");
		b.切拼("jwiq");
		b.上古音參考("wiʔ");
		b.考釋("·鷕，《廣韻》：「鷕，雉鳴也。以沼切。又羊水切。七。」戴震《聲韻考》卷四《論韻書中字義答秦尚書》：「有字雖不訛，本無其音，訛而成音。如《詩》『有瀰濟盈，有鷕雉鳴。』鷕从唯有得聲，與瀰爲句中韻，下復舉濟盈、雉鳴，亦句中韻。舊音鷕以水反(見《釋文》)，水訛作小，遂有以小反之音，《廣韻》於是收入三十小，改小作沼，並其所由致訛幾不可考。」戴說可信。後或說爲脂幽通轉，謬。");
	});
	a.廣韻意("雉鳴也以沼切又羊水切七");
});
