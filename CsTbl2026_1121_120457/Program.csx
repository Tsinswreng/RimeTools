Z("䶂", a=>{
	a.PolyMc("ciak");
	a.PolyMc("cjak");
	a.PolyMc("prauh");
	a.PolyMc("tek");
	a.Ptl(b=>{
		b.聲符("勺²");
		b.諧聲域("PEUK");
		b.反切("北敎");
		b.中古地位("幫肴二去");
		b.切拼("paewh");
		b.上古音參考("prˤeukh");
	});
	a.Ptl(b=>{
		b.聲符("勺¹");
		b.諧聲域("TEUK");
		b.反切("都歷");
		b.中古地位("端錫開四入");
		b.切拼("tek");
		b.上古音參考("tˤeuk");
	});
	a.Ptl(b=>{
		b.聲符("勺¹");
		b.諧聲域("TEUK");
		b.反切("之若");
		b.中古地位("章藥開三入");
		b.切拼("tjyak");
		b.上古音參考("teuk");
		b.考釋("·勺，傳世「勺」聲系有三類讀音：①端組宵藥部TEU[,K]、②幫組藥部PEUK、③影母藥部ɁEUK。黃易青謂「勺」一形多用爲｛勺｝*teuk和｛瓢｝*beu（說見：黃易青《論“諧聲”的鑒別及聲符的的歷史音變》），其說甚是，今據以分「勺¹」TEU[,K]、「勺²」PEUK二聲系。今本《論語·雍也》：「一瓢飲」，安大簡二《仲尼曰》作「一勺⿰氵𨟻」，是「勺」或可讀｛瓢｝、或讀｛勺｝而與｛瓢｝同謂，皆不違其理。藤堂明保、龐光華以爲乃訓讀｛杓｝（見：龐光華《上古音及相關問題綜合研究：以複輔音聲母爲中心》），未達一間。古音學家或以複輔音擬合端幫組二讀，似未審。今分爲兩聲。「約」聲音影母，與前述二音有別。鄔可晶謂「約」本讀T-，後讀影母與｛要｝義近有關（說見：鄔可晶《“弱”、“約”有關字詞的考察》），其說可從。古漢語端組幽宵部T[I,E]U當有一義爲“纏繞”的詞族，其詞如｛周｝*tiu、｛綢｝*driu（安大簡《詩》｛綢｝作「𥾯」，作「弔」聲）、｛紹｝*deuʔ。鄔可晶謂「弔」爲“纏束”之｛約(T-)｝的表意字（見：鄔可晶《甲骨文“弔”字補釋》），允爲卓識；古文字「弔」當此族詞所造之表意字。「𠣩」「約」「⿱弔勺」蓋亦本爲其所造的「勺¹」TEUK聲字，後「約」讀｛*ʔ-｝耳。");
	});
	a.Ptl(b=>{
		b.聲符("勺¹");
		b.諧聲域("TEUK");
		b.反切("即略");
		b.中古地位("精藥開三入");
		b.切拼("tsyak");
		b.考釋("·䶂，胡地鼠名，《名義》之若反；《玉篇》之若切；《新撰字鏡》之若、補救二反；《廣雅音註》音爵；《王三》之藥、都歷二反；《廣韻》北教、之若、即略、都歷四切；《經典釋文》：「䶂，郭音雀，將畧反。《字林》音灼，云：鼩鼠出胡地。郭注本『雀』字或誤爲『瞿』字，沈旋因云郭以爲鼩鼠音求于反，非也。」「䶂」一義兼有章母、精母之異讀，頗爲怪異，待考。");
	});
	a.廣韻意("䑕屬能飛食虎豹出胡地又音酌");
	a.廣韻意("鼠屬");
	a.廣韻意("鼠似兔而小也");
	a.廣韻意("鼠名又音灼");
});
