		b.聲符("曡");
		b.諧聲域("LƏP");
		b.反切("徒協");
		b.中古地位("定怗開四入");
		b.切拼("dep");
		b.上古音參考("lˤəp");
		b.考釋("·曡，《說文》：「曡，楊雄說：以爲古理官決罪，三日得其宜乃行之。从晶从宜。亡新以爲曡从三日太盛，改爲三田。」其說曲折。古文字材料中有字象刀向俎版之形，可隸作「刞」、「𫦄」、「𫦆」，以之爲聲的「𫦡」省變而有「曡」字（見：陳劍《甲骨金文舊釋“䵼”之字及相關諸字新釋》）。");
	});
	a.廣韻意("上同");
});
Z("疋", a=>{
	a.TswgOcModed("ŋrˁaʔ");
	a.TswgOcModed("sraʔ");
	a.TswgOcModed("sra");
	a.PolyMc("ngrax");
	a.PolyMc("srio");
	a.PolyMc("sriox");
	a.BsOc(b=>{
		b.Oc("*sra");
		b.Gloss("foot");
	});
	a.SchOc("sra");
	a.SchOc("pʰit");
	a.MsoegOc("sʴa");
	a.DtOc("ŋraːʔ");
	a.DtOc("sŋra");
	a.DtOc("sŋraʔ");
	a.Ptl(b=>{
		b.聲符("疋");
		b.諧聲域("TSA");
		b.反切("所葅");
		b.中古地位("生魚開三平");
		b.切拼("sryo");
		b.上古音參考("sra");
		b.考釋("·梳，「疏」省聲。·綀，《說文新附·糸部》：「綀，布屬。从糸，束聲。」鄭張尚芳《上古音系》：「《說文新附》作「束」聲，實爲「疎」聲。」其說是也。");
	});
	a.Ptl(b=>{
		b.聲符("疋");
		b.諧聲域("TSA");
		b.反切("踈舉");
		b.中古地位("生魚開三上");
		b.切拼("sryoq");
		b.上古音參考("sraʔ");
	});
	a.Ptl(b=>{
		b.聲符("夏");
		b.諧聲域("KRA");
		b.反切("五下");
		b.中古地位("疑麻開二上");
		b.切拼("ngaeq");
		b.上古音參考("ŋrˤaʔ");
		b.考釋("·疋，《說文》：「疋，古文以爲《詩》大{疋}[雅]字。」即今《大雅》之「雅」。此字形與所葅切、踈舉切之「疋」爲同形字，乃戰國時期東土文字「夏」之訛省。說見：張富海《漢人所謂古文之研究》。");
	});
	a.廣韻意("足也古爲雅字");
	a.廣韻意("記也又山於切");
	a.廣韻意("正也待也說文所𦵔切足也古文以爲詩大雅字又山吕切");
});
