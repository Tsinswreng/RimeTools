	});
	a.Ptl(b=>{
		b.聲符("殳");
		b.諧聲域("TO");
		b.反切("丁外");
		b.中古地位("端泰合一去");
		b.切拼("twajh");
		b.上古音參考("tˤoth");
		b.考釋("·祋，《說文》：「祋，殳也。从殳、示聲。或說城郭市里，高縣羊皮，有不當入而欲入者，暫下以驚牛馬曰祋。故从示、殳。《詩》曰：『何戈與祋。』」今本《毛詩·曹風·候人》作「何戈與祋」；《禮記·樂記》鄭注引「祋」作「綴」，孔穎達正義引崔靈恩《集注》云「祋」本亦作「綴」。按：「祋」聲韻與「示」遠隔，「示」聲顯非。秦漢文字有字作从「示」从「攴」，馬王堆帛書《五行》引《詩》：「未見君子，㥑(憂)心𥘦₌(惙惙)。179」今本《毛詩·召南·草蟲》作「憂心惙惙」。此「𥘦」字當是「祋」的前身，然所謂其構形古怪，「示」「攴」無意可會，也許其「攴」作爲聲符相當於「殳」之聲，韻部諧聲關係與「取」：「最」相類；也可能「𥘦」非「殳」聲、自有來源。");
	});
	a.Ptl(b=>{
		b.聲符("殳");
		b.諧聲域("TOT");
		b.反切("丁外");
		b.中古地位("端泰合一去");
		b.切拼("twajh");
		b.上古音參考("tˤoth");
		b.考釋("·祋，《說文》：「祋，殳也。从殳、示聲。或說城郭市里，高縣羊皮，有不當入而欲入者，暫下以驚牛馬曰祋。故从示、殳。《詩》曰：『何戈與祋。』」今本《毛詩·曹風·候人》作「何戈與祋」；《禮記·樂記》鄭注引「祋」作「綴」，孔穎達正義引崔靈恩《集注》云「祋」本亦作「綴」。按：「祋」聲韻與「示」遠隔，「示」聲顯非。秦漢文字有字作从「示」从「攴」，馬王堆帛書《五行》引《詩》：「未見君子，㥑(憂)心𥘦₌(惙惙)。179」今本《毛詩·召南·草蟲》作「憂心惙惙」。此「𥘦」字當是「祋」的前身，然所謂其構形古怪，「示」「攴」無意可會，也許其「攴」作爲聲符相當於「殳」之聲，韻部諧聲關係與「取」：「最」相類；也可能「𥘦」非「殳」聲、自有來源。");
	});
	a.廣韻意("祋祤縣名在馮翊又祋殳也丁外切一");
	a.廣韻意("祋祤縣名又都外切");
});
