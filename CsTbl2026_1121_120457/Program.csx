	a.Ptl(b=>{
		b.聲符("戉");
		b.諧聲域("WAT");
		b.反切("古壞");
		b.中古地位("見皆合二去");
		b.切拼("kweejh");
		b.考釋("·㧔，吵擾。古壞切之音與「戊」聲字形不合，疑本「戉」聲；唐人不分怪夬，收入《怪韻》。");
	});
	a.廣韻意("訬也");
});
Z("㧖", a=>{
	a.PolyMc("qrek");
	a.Ptl(b=>{
		b.聲符("戹");
		b.諧聲域("ɁEK");
		b.反切("於革");
		b.中古地位("影麥開二入");
		b.切拼("qeek");
		b.上古音參考("ʔrˤek");
		b.考釋("·戹，《說文》：「戹，隘也。从戶，乙聲。」其說非是。古文字「戹」象車軛正視與側視結合之形，是｛軛｝*ʔrˤek的表意字，其孔用於穿過韁繩，下爲兩軛肢。可見：何琳儀,程燕《釋戹——兼釋齊家村H190西周甲骨》等。");
	});
	a.廣韻意("上同");
});
