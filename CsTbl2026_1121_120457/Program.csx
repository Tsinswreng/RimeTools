	a.DtOc("l̥ʰoːns");
	a.Ptl(b=>{
		b.聲符("豚");
		b.諧聲域("LUN");
		b.反切("通貫");
		b.中古地位("透寒合一去");
		b.切拼("thwanh");
		b.上古音參考("l̥ˤonh");
		b.考釋("·彖，陳劍先生曾釋金文中的一獸形爲「彖」（說見：陳劍《金文“彖”字考釋》），然「墬」以之爲聲，可見此斷非圓唇韻部之「彖」，陳說非是；後謝明文申以說古文字「冢」以之爲聲（說見：謝明文《說冢》），亦不可信。疑「彖」爲「豚」之省形分化字，秦簡「豚」作「腞」（可參：段凱《“彖”字補說》、翁明鵬《說秦簡中“豚”的一種訛體》等），省「肉」而有「彖」字。");
	});
	a.Ptl(b=>{
		b.聲符("豚");
		b.諧聲域("LON");
		b.反切("通貫");
		b.中古地位("透寒合一去");
		b.切拼("thwanh");
		b.上古音參考("l̥ˤonh");
		b.考釋("·彖，陳劍先生曾釋金文中的一獸形爲「彖」（說見：陳劍《金文“彖”字考釋》），然「墬」以之爲聲，可見此斷非圓唇韻部之「彖」，陳說非是；後謝明文申以說古文字「冢」以之爲聲（說見：謝明文《說冢》），亦不可信。疑「彖」爲「豚」之省形分化字，秦簡「豚」作「腞」（可參：段凱《“彖”字補說》、翁明鵬《說秦簡中“豚”的一種訛體》等），省「肉」而有「彖」字。");
	});
