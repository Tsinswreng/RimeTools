Z("歸", a=>{
	a.TswgOcModed("kʷəj");
	a.PolyMc("kyoi");
	a.BsOc(b=>{
		b.Oc("*[k]ʷəj");
		b.Gloss("return (v.)");
	});
	a.SchOc("kʷəj");
	a.MsoegOc("kui");
	a.StaOc("kʷəj");
	a.DtOc("klul");
	a.DtOc("ktul");
	a.Ptl(b=>{
		b.聲符("歸");
		b.諧聲域("KUI");
		b.反切("舉韋");
		b.中古地位("見微合三平");
		b.切拼("kuj");
		b.上古音參考("kui");
		b.考釋("·歸，《說文》：「歸，女嫁也。从止，从婦省，𠂤聲。」甲骨文作「⿰𠂤帚」，裘錫圭先生以爲从「𠂤」、「帚(彗)」聲，其「帚」讀｛彗｝音（說見：裘錫圭《殷墟甲骨文“彗”字補說》、《説从“𡴎”聲的从“貝”與从“辵”之字》），然「歸」「彗」聲韻俱遠、不諧，其說恐非。待考。");
	});
	a.廣韻意("還也公羊傳曰婦人謂嫁曰歸亦州名古夔子國武德初割夔州之秭歸巴東二縣置州取歸國爲名也舉韋切三");
});
