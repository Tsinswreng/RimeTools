Z("䯂", a=>{
	a.PolyMc("srin");
	a.PolyMc("zrip");
	a.Ptl(b=>{
		b.聲符("䯂");
		b.諧聲域("TSƏP");
		b.反切("仕戢");
		b.中古地位("崇緝開三入");
		b.切拼("dzryip");
		b.考釋("·䯂，《說文》：「䯂，眾盛也。从木、驫聲。《逸周書》曰：『[䯂]疑沮事。』{闕。}」今本《逸周書·文酌》作「聚疑沮事」。段玉裁注：「『驫』見《馬部》，《唐韵》甫虬切；曹憲《廣雅音》曰：香幽、必幽二反；《廣韵》甫烋切、又音標。然則『䯂』音當在三部明矣。而鉉云所臻切，《篇》、《韵》皆同，與許云『驫聲』者不合。葢『燊』屬會意，『䯂』屬形聲，而皆訓盛。『燊』讀若『莘莘征夫』之『莘』，因强同之耳。」段玉裁據「驫」之中古音考「䯂」字歸上古幽部，因謂「䯂」中古音所臻切者乃同義訓讀｛燊｝，理甚明晰。然所據「驫」中古音宵幽韻者，乃左思《吳都賦》「驫䮅飍矞」之「驫」（訓義核心是“馬走皃”），與《說文》「眾馬也」之「驫」字形雖同，然其詞未必同一，不可以今律古。許慎之音難覓，余疑當以《集韻》仕戢切推「驫」之音，是許音「驫」精組緝部、讀｛集｝之同源詞；《說文》「䯂，驫聲」亦精組緝部，《名義》仕戢反得之（《名義》蓋襲自顧野王《玉篇》）。所臻切如段說訓讀｛燊｝、非許慎舊讀。古文字未見「䯂」字，以形音義考之，似與「雧」有關，待考。");
	});
	a.廣韻意("衆盛皃");
	a.廣韻意("盛衆皃");
});
