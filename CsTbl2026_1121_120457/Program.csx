	});
	a.BsOc(b=>{
		b.Oc("*(mə-)tsʰˤuʔ-s");
		b.Gloss("go to");
	});
	a.SchOc("dzûʔ");
	a.SchOc("tsʰûh");
	a.MsoegOc("dzˁuʔ");
	a.MsoegOc("tsʰˁuh");
	a.StaOc("dzʱuːʔ");
	a.DtOc("skʰuːgs");
	a.DtOc("sguːʔ");
	a.Ptl(b=>{
		b.聲符("艸");
		b.諧聲域("TSU");
		b.反切("七到");
		b.中古地位("清豪開一去");
		b.切拼("tshawh");
		b.上古音參考("tsʰˤuh");
	});
	a.Ptl(b=>{
		b.聲符("艸");
		b.諧聲域("TSU");
		b.反切("昨早");
		b.中古地位("從豪開一上");
		b.切拼("dzawq");
		b.上古音參考("dzˤuʔ");
		b.考釋("·造，傳世文字系統中“祝告”之「告」與「造」之聲符「告」來源不同，研究者論之已詳（說見：大西克也：《戰國楚系文字中的兩種“告”字——兼釋上博楚簡〈容成氏〉的“三俈”》等）。音韻學家舊據《說文》以「造」爲「告」聲，爲「造」構擬*sK-類複輔音，非是。「造」之聲符「告」上部本爲“草木”之象形「屮」（說見：陳劍《釋造》），是可視作以｛艸｝之表意字爲聲符，今據此說置合於「艸」聲。");
	});
	a.廣韻意("造作又七到切");
	a.廣韻意("至也又昨早切");
});
