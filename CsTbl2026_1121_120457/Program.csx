Z("𨜳", a=>{
	a.PolyMc("duung");
	a.Ptl(b=>{
		b.聲符("宮");
		b.諧聲域("KUŊ");
		b.反切("徒(大)冬");
		b.中古地位("曉冬一平");
		b.切拼("hong");
		b.上古音參考("hˤuŋ");
		b.考釋("·𢾮，擊空聲，又作「𣪯」。《說文》：「𣪯，擊空聲也。从殳，宮聲。」徒冬切之聲母與「宮」聲字形不合，疑早期字韻書中反切上字本作「火」（大徐本《說文》所據又音作「火宫切」即此類），或訛作「大」，遂誤讀定母。曹憲《廣雅音》音彤、是其誤已久。·𨜳，古國名，音同「𢾮」。");
	});
	a.Ptl(b=>{
		b.聲符("宮");
		b.諧聲域("KOŊ");
		b.反切("徒(大)冬");
		b.中古地位("曉冬一平");
		b.切拼("hong");
		b.上古音參考("hˤuŋ");
		b.考釋("·𢾮，擊空聲，又作「𣪯」。《說文》：「𣪯，擊空聲也。从殳，宮聲。」徒冬切之聲母與「宮」聲字形不合，疑早期字韻書中反切上字本作「火」（大徐本《說文》所據又音作「火宫切」即此類），或訛作「大」，遂誤讀定母。曹憲《廣雅音》音彤、是其誤已久。·𨜳，古國名，音同「𢾮」。");
	});
	a.廣韻意("古國名");
});
