		b.中古地位("定東一平");
		b.切拼("doung");
		b.上古音參考("lˤoŋ");
		b.考釋("·同，古文字「同」似筒形器（後加从「口」作「同」），爲｛筒｝的表意字；其有把手者作「用」（說見裘錫圭《甲骨文中的幾種樂器名稱——釋“庸”“豐”“鞀”》等）；鄔可晶指出「甬」很可能是從在「用」的豎畫上加弧筆或「▽」形的異體分化出來的（說見：鄔可晶《戰國時代寫法特殊的“曷”的字形分析，並說“𰕎”及其相關問題》）。「同」「用」「甬」諸字聲首皆來自“桶”之類的詞，故置於一處。·𪔝，蓋「𪔜」之訛字。");
	});
	a.Ptl(b=>{
		b.聲符("同");
		b.諧聲域("LOŊ");
		b.反切("徒揔");
		b.中古地位("定東一上");
		b.切拼("doungq");
	});
	a.廣韻意("馬酪又音動");
	a.廣韻意("酒壞又音同");
});
