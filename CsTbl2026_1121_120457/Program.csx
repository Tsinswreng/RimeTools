		b.反切("餘針");
		b.中古地位("以侵開三平");
		b.切拼("jim");
		b.考釋("·䒞，「㶣」之誤字，非「冘」聲。參考：龍宇純《廣韻校記》P48，楊寶忠、楊清臣《疑難字續考（十則）》。");
	});
