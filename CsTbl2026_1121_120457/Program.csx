	});
	a.TswgOcModed("nʰAŋ");
	a.PolyMc("jang");
	a.BsOc(b=>{
		b.Oc("*laŋ");
		b.Gloss("raise");
	});
	a.SchOc("laŋ");
	a.MsoegOc("laŋ");
	a.StaOc("dɮaŋ");
	a.DtOc("laŋ");
	a.Ptl(b=>{
		b.聲符("昜");
		b.諧聲域("LAŊ");
		b.反切("與章");
		b.中古地位("以陽開三平");
		b.切拼("jyang");
		b.上古音參考("laŋ");
		b.考釋("·昜，《說文》：「昜，開也。从日、一、勿。一曰飛揚。一曰長也。一曰彊者眾皃。」其說非是。古文字「昜」下之「丂」自有以組陽部音LAŊ，乃「昜」之聲符，應當是｛杖｝之表意字（說見：王正,雷建鴿《柯史簋與柯國、唐國》、陳劍2018深波甲骨學與殷商文明學術講座《以一些例子談談甲骨文字考釋可注意的問題》、李春桃《甲骨文中“丂”字新釋》等）。");
	});
	a.廣韻意("舉也說也導也明也又州名禹貢曰淮海惟揚州李巡曰江南之氣躁勁厥性輕揚故曰揚州");
});
