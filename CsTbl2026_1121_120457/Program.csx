	a.Ptl(b=>{
		b.聲符("希²");
		b.諧聲域("TI");
		b.記號("[");
		b.反切("丑亦(尺)");
		b.中古地位("徹脂開三平");
		b.切拼("trhi");
		b.上古音參考("tʰri");
		b.考釋("·𤭏，瓶也，《說文新附》作「瓻」；《P.5531切韻》丑亦反作「⿰𠫤瓦」；隸楷「希」「𠫤」「𧮫」常混用。《王一》《王三》《P.5531切韻》皆置「瓻」於昔韻，唯《裴韻》置之於脂韻；《廣韻》兩處皆收，於脂韻作「瓻」、於昔韻作「𤭏」，形聲判然兩分。按中古昔韻之音與「希」聲不合，疑早期字韻書反切下字本作「尸」（如《名義》丑尸反）、誤作「尺」，部分《切韻》系韻書遂據此誤歸昔韻，《裴韻》不誤；《廣韻》正誤皆收，是此昔韻「𤭏」之形、音皆當正。");
	});
	a.廣韻意("酒器大者一石小者五斗古之借書盛酒瓶");
});
