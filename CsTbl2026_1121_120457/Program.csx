		b.諧聲域("TAŊ");
		b.反切("他朗");
		b.中古地位("透唐開一上");
		b.切拼("thangq");
		b.上古音參考("tʰˤaŋʔ");
	});
	a.Ptl(b=>{
		b.聲符("尚");
		b.諧聲域("TAŊ");
		b.反切("胡廣");
		b.中古地位("匣唐合一上");
		b.切拼("ghwangq");
		b.考釋("·攩，此字二義多音：①擊打，《方言》卷十：「㧙、抌，推也。南楚凡相推搏曰㧙，或曰㧾。沅湧𣹋幽之語或曰攩。」郭璞注：「今江東人亦名推爲攩，音晃。」《廣雅·釋詁三》：「攩，擊也。」《方言注》音晃；《廣雅音註》音幌；《玉篇》胡廣切；《切三》胡廣反，又黃浪反；《王三》胡廣、胡浪二反；《裴韻》真朗、呼浪二反；《廣韻》他朗、胡廣、乎曠三切。②朋黨，又作「黨」。《說文》：「攩，朋羣也。」《名義》胡廣反；大徐本《說文》多朗切；小徐本《說文》胡莽反。按匣母諸音與「黨」聲字形不合，疑舌音之｛攩｝thangq與喉音之｛攩｝ghwangq本兩詞，同有“擊”義，「攩」遂訓讀後者，晉郭璞已有此讀；“朋黨”之「攩」本「黨」之異體，與訓「擊」之「攩」只是同形字，或不識其詞之別，誤將匣母訓讀音注于其上。");
	});
	a.Ptl(b=>{
		b.聲符("尚");
		b.諧聲域("TAŊ");
		b.反切("乎曠");
		b.中古地位("匣唐合一去");
		b.切拼("ghwangh");
		b.考釋("·攩，見胡廣切之「攩」。");
	});
	a.廣韻意("攩㨪搥打");
	a.廣韻意("搥打又吐朗切");
	a.廣韻意("廣雅云搥打也乎曠切四");
});
