Z("衎", a=>{
	a.PolyMc("khanh");
	a.PolyMc("khanx");
	a.SchOc("kʰâns");
	a.MsoegOc("kʰˁanh");
	a.StaOc("kʰaːnh");
	a.DtOc("kʰaːnʔ");
	a.DtOc("kʰaːns");
	a.Ptl(b=>{
		b.聲符("干");
		b.諧聲域("KAN");
		b.反切("空旱");
		b.中古地位("溪寒開一上");
		b.切拼("khanq");
	});
	a.Ptl(b=>{
		b.聲符("干");
		b.諧聲域("ŊAN");
		b.反切("空旱");
		b.中古地位("溪寒開一上");
		b.切拼("khanq");
	});
	a.Ptl(b=>{
		b.聲符("干");
		b.諧聲域("KAN");
		b.反切("苦旰");
		b.中古地位("溪寒開一去");
		b.切拼("khanh");
		b.上古音參考("kʰˤanh");
		b.考釋("·衎，樂也，該詞初作「衍」、「侃」，先秦音*kʰɫˤans。《周易·漸》「飲食衎衎」之「衎」，上博簡《周易》簡50作从「䖵」、「侃」聲；馬王堆帛書《周易》86上作「衍」。《周易》中表示“樂”的｛衎｝這個詞作「衍」，對應今本作「衎」，有明顯的一詞所使用的字形的源流關係，可以推測傳世的「衎」字是將「衍」中的「水」代替爲聲符「干」產生的，造字本義未必如《說文》（《說文·行部》「衎，行喜皃。」）所言與「行」之類有關。");
	});
	a.Ptl(b=>{
		b.聲符("干");
		b.諧聲域("ŊAN");
		b.反切("苦旰");
		b.中古地位("溪寒開一去");
		b.切拼("khanh");
		b.上古音參考("kʰˤanh");
		b.考釋("·衎，樂也，該詞初作「衍」、「侃」，先秦音*kʰɫˤans。《周易·漸》「飲食衎衎」之「衎」，上博簡《周易》簡50作从「䖵」、「侃」聲；馬王堆帛書《周易》86上作「衍」。《周易》中表示“樂”的｛衎｝這個詞作「衍」，對應今本作「衎」，有明顯的一詞所使用的字形的源流關係，可以推測傳世的「衎」字是將「衍」中的「水」代替爲聲符「干」產生的，造字本義未必如《說文》（《說文·行部》「衎，行喜皃。」）所言與「行」之類有關。");
	});
	a.廣韻意("信言又苦汗切");
	a.廣韻意("樂也");
});
