	});
	a.Ptl(b=>{
		b.聲符("髟");
		b.諧聲域("PU");
		b.反切("甫烋");
		b.中古地位("幫幽三平");
		b.切拼("pyiw");
		b.上古音參考("pu");
		b.考釋("·髟，《說文》：「髟，長髮猋猋也。从長从彡。」段玉裁注：「《五經文字》必由反、在古音三部；《桼部》䰍从此爲聲，可得此字之正音矣。音轉乃爲必凋切、匹妙切。其云所銜切者，大謬，誤認爲彡聲也。」從郭店簡「髟」字對讀傳世《君奭》「冒」看，古文字「髟」確在上古幽部。郭店楚簡《君子之於教》：「《君奭》曰：『唯髟(冒)不(丕)嘼(單)爯(稱)惪(德)。』22」今本《尚書·君奭》作「惟冒丕單稱德」。");
	});
	a.Ptl(b=>{
		b.聲符("三");
		b.諧聲域("SAM");
		b.反切("所銜");
		b.中古地位("生銜開二平");
		b.切拼("sraem");
		b.上古音參考("srˤam");
	});
	a.廣韻意("髮長皃又所銜切");
	a.廣韻意("髮垂皃又標彡二音");
	a.廣韻意("屋翼也又長髮皃");
});
