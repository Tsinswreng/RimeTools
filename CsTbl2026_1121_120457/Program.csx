Z("偔", a=>{
	a.PolyMc("ngak");
	a.DtOc("ŋaːg");
	a.Ptl(b=>{
		b.聲符("咢");
		b.諧聲域("ŊAK");
		b.反切("五各");
		b.中古地位("疑鐸開一入");
		b.切拼("ngak");
