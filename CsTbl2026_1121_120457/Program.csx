Z("彴", a=>{
	a.PolyMc("cjak");
	a.DtOc("pljewɢ");
	a.Ptl(b=>{
		b.聲符("勺¹");
		b.諧聲域("TEUK");
		b.反切("之若");
		b.中古地位("章藥開三入");
		b.切拼("tjyak");
		b.上古音參考("teuk");
		b.考釋("·勺，傳世「勺」聲系有三類讀音：①端組宵藥部TEU[,K]、②幫組藥部PEUK、③影母藥部ɁEUK。黃易青謂「勺」一形多用爲｛勺｝*teuk和｛瓢｝*beu（說見：黃易青《論“諧聲”的鑒別及聲符的的歷史音變》），其說甚是，今據以分「勺¹」TEU[,K]、「勺²」PEUK二聲系。今本《論語·雍也》：「一瓢飲」，安大簡二《仲尼曰》作「一勺⿰氵𨟻」，是「勺」或可讀｛瓢｝、或讀｛勺｝而與｛瓢｝同謂，皆不違其理。藤堂明保、龐光華以爲乃訓讀｛杓｝（見：龐光華《上古音及相關問題綜合研究：以複輔音聲母爲中心》），未達一間。古音學家或以複輔音擬合端幫組二讀，似未審。今分爲兩聲。「約」聲音影母，與前述二音有別。鄔可晶謂「約」本讀T-，後讀影母與｛要｝義近有關（說見：鄔可晶《“弱”、“約”有關字詞的考察》），其說可從。古漢語端組幽宵部T[I,E]U當有一義爲“纏繞”的詞族，其詞如｛周｝*tiu、｛綢｝*driu（安大簡《詩》｛綢｝作「𥾯」，作「弔」聲）、｛紹｝*deuʔ。鄔可晶謂「弔」爲“纏束”之｛約(T-)｝的表意字（見：鄔可晶《甲骨文“弔”字補釋》），允爲卓識；古文字「弔」當此族詞所造之表意字。「𠣩」「約」「⿱弔勺」蓋亦本爲其所造的「勺¹」TEUK聲字，後「約」讀｛*ʔ-｝耳。");
	});
	a.廣韻意("橫木渡水");
});
