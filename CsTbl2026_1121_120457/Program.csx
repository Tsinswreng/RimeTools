Z("垶", a=>{
	a.PolyMc("syeng");
	a.DtOc("seŋ");
	a.Ptl(b=>{
		b.聲符("𬙮");
		b.諧聲域("WEŊ");
		b.反切("息營");
		b.中古地位("心清合三平");
		b.切拼("swiaeng");
		b.上古音參考("ʍeŋ");
		b.考釋("·騂、垶、觪，此韻諸字古作「𬙮」聲，如《說文》之「觲」、「㙚」。古文字自有「𬙮」聲（可參：裘錫圭《殷墟甲骨文在文字學上的重要性》），从「羊」从「牛」。考中古音，切韻音系清韻銳音幾無合口，唯以母余傾、餘頃、營隻三切及心母此小韻有之（七役切、之役切不論），上古音系使然也，是「𬙮」聲域必在WEŊ（云組耕部）；或據中古音系格局改騂小韻爲開口地位，非是。秦漢文字「𬙮」已不習見，後改作「辛」。又，秦石鼓《車工》：「□₌角弓。」「□」字宋拓本殘泐難識，元代以後拓本已不可見，學者多據北宋先鋒本殘跡釋作「辛」聲之「𤙡」字，然其時「辛」「𬙮」聲不近，「辛」聲字不可讀｛觪｝*ʍeŋ，俟考。");
	});
	a.廣韻意("赤土");
});
