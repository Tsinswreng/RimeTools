Z("舌", a=>{
	a.TswgOcModed("mlat");
	a.PolyMc("ghruat", b=>{
		b.Ratio(2);
	});
	a.PolyMc("zsjet");
	a.BsOc(b=>{
		b.Oc("*mə.lat");
		b.Gloss("tongue");
	});
	a.SchOc("m-let");
	a.SchOc("m-lat");
	a.SchOc("kʷât");
	a.MsoegOc("ʱɫat");
	a.StaOc("lat");
	a.DtOc("groːd");
	a.DtOc("ɦbljed");
	a.DtOc("ɦljed");
	a.Ptl(b=>{
		b.聲符("𠯑");
		b.諧聲域("WAT");
		b.反切("下刮");
		b.中古地位("匣鎋合二入");
		b.切拼("ghwaet");
		b.上古音參考("wrˤat");
		b.考釋("·𠯑，《說文》：「𠯑，塞口也。从口，氒省聲。」其說不確，從古文字材料看，「𠯑」之上部與「氒」爲兩字。趙平安將傳世「𠯑」字與甲骨文所謂「⿱乇口」（于省吾《甲骨文字釋林》所釋，並讀爲｛磔｝）牽連，是以「𠯑」爲「乇」聲（說見：趙平安《續釋甲骨文中的“乇”、“⿱乇口”、“⿰礻⿱乇口”》）。然「𠯑」「乇」聲韻俱遠，于、趙二說不可兼存。甲骨文所謂「⿱乇口」待考。趙文釋《集成》03840首字爲「話」甚確，其所从乃一整體，是「𠯑」本整體表意字，似與甲骨文「⿱乇口」無涉。");
	});
	a.Ptl(b=>{
		b.聲符("舌¹");
		b.諧聲域("LAT");
		b.反切("食列");
		b.中古地位("船薛開三入");
		b.切拼("zjiet");
		b.上古音參考("mlat");
		b.考釋("·舌，古文字「舌」一形多用有兩類讀音：①以組月部LAT，爲｛舌｝之表意字；②以組談部LEM，爲｛𦧥｝之表意字。說見：陳斯鵬《“舌”字古讀考》。");
	});
	a.廣韻意("塞口說文作𠯑話栝之類从此");
	a.廣韻意("口中舌山海經云長舌山有獸名長舌狀如禺而四耳出則郡多水又姓左傳越大夫舌庸也食列切四");
});
