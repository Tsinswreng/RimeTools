Z("氏", a=>{
	a.TswgOcModed("ɡeʔ");
	a.TswgOcModed("ɡleʔ");
	a.PolyMc("cieng", b=>{
		b.Ratio(1);
	});
	a.PolyMc("cje", b=>{
		b.Ratio(2);
	});
	a.PolyMc("zjex");
	a.BsOc(b=>{
		b.Oc("*k.deʔ");
		b.Gloss("clan");
	});
	a.SchOc("geʔ");
	a.SchOc("ke");
	a.MsoegOc("gɛʔ");
	a.DtOc("skeŋ");
	a.DtOc("kje");
	a.DtOc("gjeʔ");
	a.Ptl(b=>{
		b.聲符("氏");
		b.諧聲域("TE");
		b.反切("章移");
		b.中古地位("章支開三平");
		b.切拼("tjie");
		b.上古音參考("te");
		b.考釋("·氏，傳世文字系統中所謂「氏」聲系於切韻聲系有兩類：一者章組支韻系，如「氏」「紙」等；一者群母支韻巨支切，有「祇」「軝」等字。舊據以將「氏」聲諸字構擬爲牙喉音K-，謂中古章組諸字乃K-顎化之故，實非。張富海據氏族之｛氏｝於出土材料多作「是」、｛是｝亦有作「氏」者，論「氏」之古音在舌尖塞音T-（說見：張富海《據古文字論“氏”、“視”等字的上古聲母》），應可信。然中古巨支切諸字費解，白-沙構擬*kd-之類複輔音，張文從之，謂聲幹d-被冠音k-同化而讀中古群母，恐難信。舊謂「氏」「氐」一字之分化，或據中古群母諸字疑其非（見：大西克也《從出土資料再論章系字腭化的年代》），莫衷一是。俟考。");
	});
	a.Ptl(b=>{
		b.聲符("氏");
		b.諧聲域("TE");
		b.反切("承紙");
		b.中古地位("常支開三上");
		b.切拼("djieq");
	});
	a.廣韻意("月氏國名又閼氏匈奴皇后也又精是二音");
	a.廣韻意("狋氏縣名狋音權");
	a.廣韻意("氏族又支[指/精]二音");
});
