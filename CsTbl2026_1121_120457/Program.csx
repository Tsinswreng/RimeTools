Z("亳", a=>{
	a.PolyMc("bak");
	a.SchOc("bâk");
	a.DtOc("blaːg");
	a.Ptl(b=>{
		b.聲符("京²");
		b.諧聲域("PAK");
		b.反切("傍各");
		b.中古地位("並鐸一入");
		b.切拼("bak");
		b.上古音參考("bˤak");
		b.考釋("·亳，《說文》：「亳，京兆杜陵亭也。从高省，乇聲。」｛亳｝古音*bˤak（清華簡《尹至》作「白」PAK），其聲母與「乇」TAK不合，「乇」斷非聲也。林義光《文源》謂「『亳』與『乇』不同音」，似已察其聲之異，然又云「从京、宅省，京、宅互體而省」則不可信。甲骨文中舊釋「亳」者實爲「蒿」（說見：李學勤《釋“郊”》等），不論；東周文字中舊釋「亳」者，今學者多改釋「京」。郭永秉疑傳世文獻之「亳」是自「京」字分化而出（說見：郭永秉《“京”“亭”“亳”獻疑》），很可參考；近出曾公編鐘M190:30有「京社」二字，研究者或讀｛亳社｝（參看：陳民鎮《曾公⿰田求編鐘銘文補說》），可爲郭說之佳證。按｛亳｝*bˤak、｛京｝*kraŋ聲母迥異，上引郭文所謂音近云云非是；古都邑之「京」既可稱｛京｝*kraŋ、又可稱｛亳｝*bˤak，固自然之理，古文字系統的「京」當自有見來組陽部KRAŊ、幫組鐸部PAK二讀，後者分化作「亳」耳（有變形音化的因素）。");
	});
	a.廣韻意("國名春秋時陳地漢爲沛之譙縣魏爲譙郡晉爲南兖州齊爲亳州");
});
