Z("𤺺", a=>{
	a.PolyMc("tanx");
	a.BsOc(b=>{
		b.Oc("*tˤanʔ");
		b.Gloss("illness; toil");
	});
	a.SchOc("tânʔ");
	a.MsoegOc("tˁanʔ");
	a.Ptl(b=>{
		b.聲符("旦");
		b.諧聲域("TAN");
		b.反切("多旱");
		b.中古地位("端寒開一上");
		b.切拼("tanq");
		b.上古音參考("tˤanʔ");
		b.考釋("·亶，其上「㐭」亦有端組元部之音、當亦爲聲首，後加注「旦」聲而作「亶」。參考：石小力《清華簡〈五紀〉的“壇”與郭店簡〈唐虞之道〉的“禪”》。");
	});
	a.廣韻意("病也");
});
