Z("皀", a=>{
	a.PolyMc("hiang");
	a.PolyMc("kip");
	a.PolyMc("pik");
	a.PolyMc("pip");
	a.BsOc(b=>{
		b.Oc("*qʰaŋ");
		b.Gloss("fragrance");
	});
	a.SchOc("haŋ");
	a.MsoegOc("xaŋ");
	a.DtOc("pqrɯg");
	a.DtOc("pqrɯb");
	a.DtOc("krɯb");
	a.DtOc("qʰaŋ");
	a.Ptl(b=>{
		b.聲符("皀");
		b.諧聲域("—");
		b.反切("彼及");
		b.中古地位("幫緝三B入");
		b.切拼("pyip");
		b.考釋("·鵖，「鵖鴔」又作「𪀐鵖」。《爾雅·釋鳥》：「鵖鴔，戴鵀。」郭璞注：「鵖鴔，猶𪃃鶝，語聲轉耳。」《說文·鳥部》：「𪀐，𪀐鵖也。从鳥、乏聲。」又：「鵖，𪀐鵖也。从鳥、皀聲。」「鵖」本「皀」聲，「皀」《通俗文》音方力反，此諧聲與「鶝」相合，是「𪃃鶝」「𪀐鵖」本一詞，一聲之轉也，疑當是鳥叫之擬音詞。");
	});
	a.Ptl(b=>{
		b.聲符("皀");
		b.諧聲域("—");
		b.反切("彼側");
		b.中古地位("幫職三入");
		b.切拼("pyik");
		b.考釋("·皀，古文字「皀」乃｛簋｝之表意字，中古諸音皆不古。《說文》：「皀，穀之馨香也。象嘉穀在裹中之形。匕，所以扱之。或說皀，一粒也。凡皀之屬皆从皀。又讀若香。」《顏氏家訓·勉學》：「吾在益州，與數人同坐，初晴日晃，見地上小光，問左右：『此是何物？』有一蜀豎就視，答云：『是豆逼耳。』相顧愕然，不知所謂。命取將來，乃小豆也。窮訪蜀士，呼粒爲逼，時莫之解。吾云：『《三蒼》、《說文》，此字白下爲匕，皆訓粒，《通俗文》音方力反。』眾皆歡悟。」《史記·扁鵲倉公列傳》：「血如豆比五六枚。」徐復謂「豆比即豆皀」（說見：徐復《〈廣韻〉音義續箋》）。");
	});
	a.Ptl(b=>{
		b.聲符("皀");
		b.諧聲域("—");
		b.反切("居立");
		b.中古地位("見緝開三B入");
		b.切拼("kyip");
	});
	a.Ptl(b=>{
		b.聲符("卿");
		b.諧聲域("KLAŊ");
		b.反切("許良");
		b.中古地位("曉陽開三平");
		b.切拼("hyang");
		b.上古音參考("h(l)aŋ");
		b.考釋("·皀，《說文》：「皀，又讀若香。」此音蓋自「鄉」字剝離而來，《說文》析「鄉」爲「皀」聲，因予「皀」陽部音。");
	});
	a.廣韻意("稻香");
	a.廣韻意("皀粒");
	a.廣韻意("穀香");
	a.廣韻意("穀香也");
});
