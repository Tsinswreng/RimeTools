		b.考釋("·晝，《說文》：「从畫省，从日。」今人或說爲从「日」、「聿」聲（說見：何琳儀、黃錫全《㝬簋考釋六則》、劉釗《古璽格言璽考釋一則》），乖違音理，不可信。未詳。");
	});
	a.廣韻意("日中又姓晝邑大夫之後因氏焉出風俗通陟救切三");
});
Z("晞", a=>{
	a.PolyMc("hioi");
	a.SchOc("həj");
	a.MsoegOc("xəi");
	a.StaOc("həj");
	a.DtOc("hlɯl");
	a.Ptl(b=>{
		b.聲符("希¹");
		b.諧聲域("KƏI");
		b.反切("香衣");
		b.中古地位("曉微開三平");
		b.切拼("hyj");
		b.上古音參考("həi");
		b.考釋("·希，傳世「希」聲諸字有兩類讀音：①曉母微部KƏI，「稀」屬此類；②端組脂部TI，「絺」屬此類。《說文》以「絺」爲「希」聲，舊皆從之。安大簡《詩》絺綌之｛絺｝作「⿰希氐」，是「氐」聲字，可見｛絺｝當歸上古端組脂部TI，與牙喉音微部的「希」聲不諧。張富海謂「希」本身應該兼具二音，既是｛絺｝的初文、又可以表示“稀疏”之｛稀｝（說見：張富海《“希”字古音考》），可信。初，林澐釋九年衛鼎〔《集成》02831〕「𧮫」字（見：林沄《新版〈金文編〉正文部分釋字商榷》），其上作線條交織之形。鄔可晶先生謂其上爲是｛綌｝（粗葛布）、｛絺｝（細葛布）共同的初文（見：鄔可晶《說金文“䝳”及相關之字》），甚有啟發性。總言之，古文字作線條交織者，可讀三類讀音，因其線條之稀疏，可爲｛稀｝*həi之表意字；因其密，可爲｛緻｝*drih之表意字（古漢語端組脂部TI有一個表示“細膩”的詞族，其詞如“細緻”的｛緻｝*drih、“細葛布”的｛絺｝*tʰri、“細磨刀石”的｛厎｝*tiʔ）；因其有隙，可爲｛隙｝*kʰrak（與表示“粗葛布”的｛綌｝*kʰrak同源）之表意字；因而一形多用爲三類讀音，是爲三聲系。前二音於傳世文字系統作「希」旁，末者KAK作「𧮫」旁、後隸楷混作「谷」形。");
	});
	a.廣韻意("日氣乾也");
});
