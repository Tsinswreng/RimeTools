Z("邢", a=>{
	a.PolyMc("gheng");
	a.BsOc(b=>{
		b.Oc("*[g]ˤeŋ");
		b.Gloss("Xíng (place name)");
	});
	a.SchOc("gêŋ");
	a.MsoegOc("gˁɛŋ");
	a.DtOc("geːŋ");
	a.Ptl(b=>{
		b.聲符("刑");
		b.諧聲域("KEŊ");
		b.反切("戸經");
		b.中古地位("匣青開四平");
		b.切拼("gheng");
		b.上古音參考("ɡˤeŋ");
		b.考釋("·刑、形，舊或以爲「井」聲，非是。其聲符本與“水井”之「井」不同（說見：張富海《說“井”》），可能是“型范”之｛型｝的初文。今據張說與「井」分爲兩聲系。·邢，鄭地名，《說文》作「𨙷」，與「幵」聲之「邢」爲同形字。");
	});
	a.Ptl(b=>{
		b.聲符("幵");
		b.諧聲域("KE");
		b.反切("苦堅");
		b.中古地位("溪先開四平");
		b.切拼("khen");
		b.上古音參考("kʰˤen");
	});
	a.Ptl(b=>{
		b.聲符("幵");
		b.諧聲域("KEN");
		b.反切("苦堅");
		b.中古地位("溪先開四平");
		b.切拼("khen");
		b.上古音參考("kʰˤen");
	});
	a.Ptl(b=>{
		b.聲符("幵");
		b.諧聲域("ŊEN");
		b.反切("苦堅");
		b.中古地位("溪先開四平");
		b.切拼("khen");
		b.上古音參考("kʰˤen");
	});
	a.廣韻意("地名在鄭亦州名古邢侯國也項羽爲襄國隋爲邢州取國以名之又姓出河閒也本周之𦙍邢侯爲衞所滅後遂爲氏漢有侍中邢辟直道忤時讁爲河閒[鄭/鄚]令因家焉");
});
Z("那", a=>{
	a.TswgOcModed("nˁal");
	a.PolyMc("na", b=>{
		b.Ratio(2);
	});
	a.PolyMc("nah", b=>{
		b.Ratio(96);
	});
	a.BsOc(b=>{
		b.Oc("*nˤar");
		b.Gloss("ample");
	});
	a.SchOc("nâj");
	a.MsoegOc("nˁal");
	a.StaOc("n⁽ʱ⁾aːr");
	a.DtOc("naːl");
	a.DtOc("naːlʔ");
	a.DtOc("naːls");
	a.Ptl(b=>{
		b.聲符("冄");
		b.諧聲域("NAI");
		b.反切("諾何");
		b.中古地位("泥歌開一平");
		b.切拼("na");
		b.上古音參考("nˤai");
		b.考釋("·那，《說文》：「𨙻，西夷國。從邑、冄聲。安定有朝𨙻縣。」「冄」聲與「那」韻母有異，待考。");
	});
	a.Ptl(b=>{
		b.聲符("冄");
		b.諧聲域("NAI");
		b.反切("奴可");
		b.中古地位("泥歌開一上");
		b.切拼("naq");
		b.上古音參考("nˤaiʔ");
	});
	a.Ptl(b=>{
		b.聲符("冄");
		b.諧聲域("NAI");
		b.反切("奴箇");
		b.中古地位("泥歌開一去");
		b.切拼("nah");
		b.上古音參考("nˤaih");
	});
	a.廣韻意("何也都也於也盡也詩云受福不那那多也亦朝那縣名在安定又姓西魏揚州刺史那椿諾何切九");
	a.廣韻意("俗言那事本音儺");
	a.廣韻意("語助又奴哥切");
});
