Z("冘", a=>{
	a.PolyMc("jim");
	a.PolyMc("ju");
	a.SchOc("ləm");
	a.DtOc("lu");
	a.DtOc("lum");
	a.Ptl(b=>{
		b.聲符("宂");
		b.諧聲域("LU");
		b.反切("以周");
		b.中古地位("以尤三平");
		b.切拼("ju");
		b.上古音參考("lu");
		b.考釋("·冘，古書「冘豫」同「猶豫」。傳世文字系統中以組幽部LU有個來源不明的聲首，其傳世諧聲字或作「冘」「穴」「宂」旁（如「冘」「貁」「抭」）。今且從段玉裁說置於「宂」聲。馬王堆帛書《周易·豫》：「九四，△餘（豫）。」今本作「由豫」，「△」帛書整理小組釋作「允」，以爲係「冘」之誤字；後研究者或不認爲誤字而以「允」「由」音近相通爲說（見《長沙馬王堆漢墓簡帛集成》第3卷P23所述）。按文、幽不可通，後說非是，此「△」乃「宂」LU聲系之早見者。·抌，抒臼，《說文》作「抭」，段玉裁注：「从手、宂聲也。」");
	});
	a.Ptl(b=>{
		b.聲符("冘");
		b.諧聲域("TƏM");
		b.反切("餘針");
		b.中古地位("以侵開三平");
		b.切拼("jim");
		b.考釋("·冘，《說文》：「冘，淫淫，行皃。」沈濤《古本考》、段玉裁《注》謂「淫淫」本作「冘冘」。");
	});
	a.廣韻意("冘豫不定");
	a.廣韻意("行皃");
});
