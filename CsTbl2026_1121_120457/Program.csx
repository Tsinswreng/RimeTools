Z("蛜", a=>{
	a.PolyMc("qjii");
	a.DtOc("qlil");
	a.Ptl(b=>{
		b.聲符("尸");
		b.諧聲域("LI");
		b.反切("於脂");
		b.中古地位("影脂開三A平");
		b.切拼("qi");
		b.上古音參考("ʔɫi");
		b.考釋("·伊，舊多以「伊」爲「尹」聲，實於韻部不合，不論。疑「伊」本从「尹」、「尸」聲。字形上，殷商甲骨文卜辭之「伊」旁或作蹲踞人形，歷組卜辭亦有以「尹」爲義符的“索尹”之「⿰索尹」；音韻上，「伊」上古應帶*-l-，擬作*ʔli，所據材料如下：①「伊」有以「𠒁(死)」*ɬiʔ爲聲符的古文異體「𠈽」；②伊尹之｛伊｝在楚簡中又作「泗」，以「四」*ɬih聲字記錄；③《毛詩·衛風·碩人》「齒如瓠犀」，阜陽漢簡作「齒如會⿰言伊」；漢代碩人銅鏡作「齒如會師」，是以用「伊」聲字「⿰言伊」記錄｛犀｝。鄭張亦認爲「伊」聲母有後置成分*-l，說見：鄭張尚芳《古吳越地名中的侗台語成分》。");
	});
});
