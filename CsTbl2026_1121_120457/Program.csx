Z("𧠠", a=>{
	a.PolyMc("me");
	a.Ptl(b=>{
		b.聲符("民");
		b.諧聲域("MIN");
		b.反切("莫兮");
		b.中古地位("明齊四平");
		b.切拼("mej");
		b.考釋("·𧠠，病人視。《說文》：「𧠟，病人視也。从見氐聲。讀若迷。」段注改篆作「𧠠」，謂：「按各本篆作𧠟，解作氐聲。氐聲則應讀若低，與讀若迷不協。攷《廣韵》十二齊曰：『𧠠，病人視皃。』《集韵》曰：『𧠠𧠟二同。』《類篇》曰：『𧠟𧠠二同。』《集韵》、《類篇》𧠠又民堅切，訓病視。葢古本作𧠠、民聲。讀若眠者、其音變。讀若迷者、雙聲合音也。唐人諱民，偏旁省一畫，多似氏字。始作𬡼，繼又譌作𧠟。乃至正譌並存矣。今改从正體。莫兮切。古音在十一部。」");
	});
	a.廣韻意("病人視皃");
});
