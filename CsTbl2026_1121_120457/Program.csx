Z("季", a=>{
	a.TswgOcModed("kʷits");
	a.PolyMc("kjyih");
	a.BsOc(b=>{
		b.Oc("*kʷi[t]-s");
		b.Gloss("youngest");
	});
	a.SchOc("kʷis");
	a.SchOc("kʷits");
	a.MsoegOc("kwih");
	a.StaOc("kʷitɕ");
	a.DtOc("kʷids");
	a.Ptl(b=>{
		b.聲符("季");
		b.諧聲域("WI");
		b.反切("居悸");
		b.中古地位("見脂合三A去");
		b.切拼("kwih");
		b.上古音參考("kwih");
		b.考釋("·季，大徐本《說文》：「季，少偁也。从子，从稚省，稚亦聲。」小徐本：「少偁。從子、稚省，稚亦聲。」「稚」省聲無稽。鄔可晶先生謂其以｛穗｝之表意字爲聲。說見：鄔可晶《釋“穗”》。");
	});
	a.廣韻意("昆季也又少也小稱也亦姓左傳魯有季友又漢複姓四氏晉有唐邑大夫季連齊有鬼方氏第六子名季連其後氏焉晉有祁邑大夫季瓜忽宋有季隨逢丗本云周有八士季隨季騧之後騧或作瓜又有魯大夫齊季窺昔齊公子季奔于楚楚遂号爲齊季氏居悸切二");
});
