Z("跮", a=>{
	a.PolyMc("thriih");
	a.PolyMc("thrit");
	a.DtOc("tʰigs");
	a.DtOc("tʰig");
	a.Ptl(b=>{
		b.聲符("至");
		b.諧聲域("TIK");
		b.反切("丑栗");
		b.中古地位("徹質開三入");
		b.切拼("trhit");
		b.上古音參考("tʰrik");
	});
	a.Ptl(b=>{
		b.聲符("至");
		b.諧聲域("TIK");
		b.反切("丑利");
		b.中古地位("徹脂開三去");
		b.切拼("trhih");
		b.上古音參考("tʰrikh");
		b.考釋("·𦥊，大徐本《說文》：「𦥊，忿戾也。从至，至而復遜。遜，遁也。《周書》曰：『有夏氏之民叨𦥊。』𦥊，讀若摯。」小徐本二「遜」皆作「孫」。今本《尚書·多方》：「亦惟有夏之民叨懫」。此字當分析爲从「孫」、「至」聲，从「孫」者乃取“遜”與“懫”反意（說見：陳劍《說“規”等字並論一些特別的形聲字意符》）。");
	});
	a.廣韻意("跮踱乍前乍卻");
	a.廣韻意("⿰⻊無也又丑利切");
});
