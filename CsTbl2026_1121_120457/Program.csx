Z("孰", a=>{
	a.TswgOcModed("duk");
	a.TswgOcModed("duwk", b=>{
		b.Note("ts");
	});
	a.PolyMc("zjuk");
	a.BsOc(b=>{
		b.Oc("*[d]uk");
		b.Gloss("who");
	});
	a.SchOc("duk");
	a.MsoegOc("duk");
	a.DtOc("djɯwɢ");
	a.Ptl(b=>{
		b.聲符("孰");
		b.諧聲域("TUK");
		b.反切("殊六");
		b.中古地位("常屋三入");
		b.切拼("djuk");
		b.上古音參考("duk");
		b.考釋("·孰，《說文》：「孰，食飪也。从丮，𦎫聲。《易》曰：『孰飪。』」徐鍇曰：「從手，丮取是孰也。會意。」段玉裁注：「此會意。各本衍『聲』字，非也。殊六切。三部。」文部「𦎫」與幽部「孰」不諧，前人以「𦎫」非聲是也。陳劍先生以爲「丮」有｛祝｝音，「夙」以之爲聲，唯聲紐不合，見「夙」下。待考。");
	});
	a.廣韻意("誰也");
});
