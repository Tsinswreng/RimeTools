Z("掆", a=>{
	a.PolyMc("kang");
	a.PolyMc("kangh");
	a.DtOc("klaːŋ");
	a.DtOc("klaːŋs");
	a.Ptl(b=>{
		b.聲符("剛");
		b.諧聲域("KAŊ");
		b.反切("古郎");
		b.中古地位("見唐開一平");
		b.切拼("kang");
		b.上古音參考("kˤaŋ");
		b.考釋("·岡，「剛」之省形字。·剛，或說以「网」爲聲首，似非。殷商甲金文有一字从「刀」从「网」，殷周早期金文｛剛｝、｛犅｝以之爲聲符而不徑以「网」爲聲符，是从「刀」从「网」之字似非以明母「网」爲聲。·㓻，「剛」之俗字，其下部「止」爲「山」之訛形。");
	});
	a.Ptl(b=>{
		b.聲符("剛");
		b.諧聲域("KAŊ");
		b.反切("古浪");
		b.中古地位("見唐開一去");
		b.切拼("kangh");
		b.上古音參考("kˤaŋh");
	});
	a.廣韻意("舉也");
	a.廣韻意("捎掆舁也出字林");
});
