	a.BsOc(b=>{
		b.Oc("*s.[d]aŋʔ");
		b.Gloss("elephant");
	});
	a.SchOc("s-jaŋʔ");
	a.SchOc("zjaŋʔ");
	a.MsoegOc("[l̃]aŋʔ");
	a.DtOc("ljaŋʔ");
	a.Ptl(b=>{
		b.聲符("象");
		b.諧聲域("LAŊ");
		b.反切("徐兩");
		b.中古地位("邪陽開三上");
		b.切拼("zyangq");
		b.上古音參考("slaŋʔ");
	});
	a.廣韻意("說文曰象長鼻牙南越大獸三季一乳象耳牙四足之形爾雅曰南方之美者有梁山之犀象");
});
