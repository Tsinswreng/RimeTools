Z("盩", a=>{
	a.PolyMc("triu");
	a.SchOc("tru");
	a.DtOc("tu");
	a.Ptl(b=>{
		b.聲符("𪯎");
		b.諧聲域("LIU");
		b.反切("張流");
		b.中古地位("知尤三平");
		b.切拼("tru");
		b.考釋("·盩，《說文》：「盩，引擊也。从幸、攴，見血也。扶風有盩厔縣。」其說不可信。「盩」當分析爲从「皿」、「𪯎」聲。古文字「𪯎」从「㚔」从「攴」，古音在以組幽部L(I)U，其例如：①西周金文之「𢿐龢」「盭龢」當讀爲｛修和｝，《逸周書·祭公》：「執和周國」，清華竹簡一《祭公》作「⿱攸土」；②秦駰玉版：「永戁(歎)憂盩(怞)。」其文叶幽部韻；③秦石鼓《乍原》：「□□盩(修)道。」可參：施謝捷《釋“盩”》、張崇禮《清華簡〈芮良夫毖〉考釋》、王瑜楨《〈清華三·芮良夫毖〉“頪”字考——兼釋“盭和庶民”》等。此字舊亦多與戰國兵器銘文之「𪯎齊」之「𪯎」牽連，後者實爲「執」之異體，（參：李學勤《〈考工記〉與戰國兵器銘文的“執齊”》、周波《〈嶽麓書院藏秦簡（柒）〉研讀》），非一字，不論。上述辭例①或讀｛調｝*dˤiu，雖與傳世音密合，然審諸他例（尤以《祭公》異文爲定點）可見應讀L-而非T-。以組L-聲母按例不入中古知母，是由「盩厔」雙聲聯緜同化而讀知母，抑或其他特殊音變。");
	});
	a.廣韻意("盩厔縣在京兆府水曲曰盩山曲曰厔又云引擊也");
});
