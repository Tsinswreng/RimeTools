Z("㱇", a=>{
	a.PolyMc("srik");
	a.Ptl(b=>{
		b.聲符("奧");
		b.諧聲域("ɁUK");
		b.記號("{");
		b.反切("火弔");
		b.中古地位("曉蕭開四去");
		b.切拼("hewh");
		b.考釋("·㱇，《說文》：「㱇，悲意。从欠、嗇聲。」段注：「小怖曰㱇。《公羊傳》『㱇然而駭』是也。按今《公羊》作『色然』。…合諸書攷之㱇下當云小怖也。从欠、嗇聲。引《公羊傳》『㱇然而駭』。又出『𣤡』篆，下當云：『悲意。从欠、奧聲。』今本舛奪。故《廣韵》、《集韵》仍之，『㱇』注：悲意、火弔切，非也；《類篇》『𣤡』注：馨叫切、悲意，是也。」其說是也，當改《說文》作「㱇，小怖也。从欠、嗇聲。𣤡，悲意。从欠、奧聲。」火弔切蓋脫字「𣤡」之音，「㱇」本音所力切、與「色」同音。");
	});
	a.Ptl(b=>{
		b.聲符("來");
		b.諧聲域("RƏ");
		b.反切("所力");
		b.中古地位("生職開三入");
		b.切拼("sryk");
		b.上古音參考("r̥ək");
	});
	a.Ptl(b=>{
		b.聲符("來");
		b.諧聲域("MRƏK");
		b.反切("所力");
		b.中古地位("生職開三入");
		b.切拼("sryk");
		b.上古音參考("r̥ək");
	});
	a.Ptl(b=>{
		b.聲符("來");
		b.諧聲域("KRƏK");
		b.反切("所力");
		b.中古地位("生職開三入");
		b.切拼("sryk");
		b.上古音參考("r̥ək");
	});
	a.廣韻意("小怖皃");
});
Z("㱊", a=>{
	a.PolyMc("qiu");
	a.Ptl(b=>{
		b.聲符("㥑");
		b.諧聲域("ɁU");
		b.反切("於求");
		b.中古地位("影尤三平");
		b.切拼("qu");
		b.上古音參考("ʔ(r)u");
		b.考釋("·憂，《說文》：「憂，和之行也。从夊，𢝊聲。《詩》曰：『布政憂憂。』」《說文》：「𢝊，愁也。从心从頁。」按：《說文》之說不可信。李運富指出古文字「頁」「首」音義尚未分化，「𢝊」所从的「頁」讀幽部音、應該是聲符（說見：李運富《楚國簡帛文字構形系統研究》、裘錫圭《從殷墟卜辭的“王占曰”說到上古漢語的宵談對轉》），其說具有啟發性。然讀LU的「頁（首）」與「𢝊」ɁU聲紐迥異，恐不能自然諧聲。也許「頁（首）」聲的「𢝊」本來應讀｛怞｝（同源詞如｛陶｝｛妯｝｛軸｝｛㾄｝等）一類表示“憂病”的詞，後訓讀｛憂｝（與｛怮｝同源）；抑或｛𢝊｝的聲母本有流音成分，與LU音近（秦駰玉版「永戁(歎)憂盩(怞)」仍爲同源詞連用？），後爲影母*ʔ-。未詳。");
	});
	a.廣韻意("氣逆");
});
