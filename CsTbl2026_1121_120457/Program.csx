Z("腦", a=>{
	a.TswgOcModed("nˁuʔ");
	a.PolyMc("nauh", b=>{
		b.Ratio(1);
	});
	a.PolyMc("naux");
	a.BsOc(b=>{
		b.Oc("*nˤ[u]ʔ");
		b.Gloss("brain");
	});
	a.SchOc("nâwʔ");
	a.SchOc("nûʔ");
	a.MsoegOc("nˁuʔ");
	a.DtOc("nuːʔ");
	a.DtOc("nuːs");
	a.Ptl(b=>{
		b.聲符("匘");
		b.諧聲域("NU");
		b.反切("奴晧");
		b.中古地位("泥豪開一上");
		b.切拼("nawq");
		b.上古音參考("nˤuʔ");
		b.考釋("·腦，楚簡有一字對讀｛柔｝，郭店楚簡《六德》簡31：「仁類△(柔)而速」，陳劍先生將之與後世之「匘」「𠜶」「𦭣」聯繫起來（參：陳劍《郭店簡〈六德〉用爲“柔”之字考釋》），甚是。睡虎地秦簡《封診式》簡57：「𡵩(腦)角出(䪼)皆血出。」漢簡中「𡵩」漸漸訛變，遂作「𡿺」形（也有理據重構的成分），乃有所謂「𡿺」聲諸字。陳文初稿據「△」上推出有一“以刀斷艸”之形的聲首、定爲“芻蕘”之｛蕘｝的表意初文，不可信；其補記指出楚簡「△」與「夒」字有關，是也。甲金文有一字爲「夒」反持斧鉞之形，乃此系列諸字之聲首（參：鄔可晶《“夒”及有關諸字綜理》），《說文》「匘」字中的「匕」、《墨子》「𠜶」字中的「刀」爲「夒」身形之孑遺，可與上引楚簡「△」並觀。·𧳦，又作「𧳀」，或訛作「𧴎」。見平表切之「𧴎」。");
	});
	a.Ptl(b=>{
		b.聲符("匘");
		b.諧聲域("NU");
		b.反切("那到");
		b.中古地位("泥豪開一去");
		b.切拼("nawh");
	});
	a.廣韻意("上同或從匘餘同");
	a.廣韻意("優皮也");
});
