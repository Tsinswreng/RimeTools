Z("亼", a=>{
	a.PolyMc("zip");
	a.DtOc("zub");
	a.Ptl(b=>{
		b.聲符("亼");
		b.諧聲域("—");
		b.反切("秦入");
		b.中古地位("從緝開三入");
		b.切拼("dzip");
		b.考釋("·亼，《說文》：「𠓛，三合也。从入、一，象三合之形。凡𠓛之屬皆从𠓛。讀若集。」傳世文字系統中的「亼」多來自倒口之形（參：林義光《文源》），古文字無“集合”之「亼」字。楚文字「𰍜」字間或增一橫飾筆，上部因似「亼」形，朱德熙以爲即「亼」聲（說見：朱德熙《壽縣出土楚器銘文研究》），恐顛倒源流。傳世「亼」字本自《說文》系統，或爲許慎析「合」从「亼」而來，以爲有“集合”義而讀｛集｝；或爲許慎析古文“集”（即上述「𰍜」字）而來。可參：張世超《楚文字札記》第一則（《古文字研究》第29輯）。");
	});
	a.廣韻意("說文云三合也从入一象三合之形合僉之類皆从此又子入切");
});
