Z("只", a=>{
	a.TswgOcModed("kejʔ");
	a.PolyMc("cje", b=>{
		b.Ratio(4);
	});
	a.PolyMc("cjex");
	a.SchOc("keʔ");
	a.DtOc("klje");
	a.DtOc("kljeʔ");
	a.Ptl(b=>{
		b.聲符("枳");
		b.諧聲域("KE");
		b.反切("章移");
		b.中古地位("章支開三平");
		b.切拼("tjie");
		b.上古音參考("ke");
		b.考釋("·巵，《說文》：「巵，圜器也。一名觛。所以節飲食。象人，卪在其下也。《易》曰：君子節飲食。」所謂「象人，卪在其下也」不可信。戰國文字「只」除去「口」的下部似F形，我頗疑「卮」从「卩」、「只」省聲。秦漢文字材料中｛卮｝亦作「𣏌」、「栀」（參考：李家浩《〈易林〉校勘一得──兼談江陵鳳凰山漢簡中的“𣏌”字》），是亦「枳」省聲，唯所省不同耳。");
	});
	a.Ptl(b=>{
		b.聲符("枳");
		b.諧聲域("KE");
		b.反切("諸氏");
		b.中古地位("章支開三上");
		b.切拼("tjieq");
		b.上古音參考("keʔ");
		b.考釋("·枳，裘錫圭先生謂古文字「枳」从「木」，指事符號「口」形著於枝上，爲｛枳/枝｝之初文。「只」是「枳」的省形分化字。說見：鄔可晶《上古漢語中本來是否存在語氣詞“只”的問題的再檢討——以出土文獻所見辭例和字形爲中心》、裘錫圭《齊量制補說》。");
	});
	a.廣韻意("專辝又之爾切");
	a.廣韻意("語辤");
});
