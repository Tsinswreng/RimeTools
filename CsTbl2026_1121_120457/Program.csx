	a.SchOc("tûk");
	a.MsoegOc("[s]ˁuk");
	a.MsoegOc("tˁuk");
	a.DtOc("ʔl'uːwɢ");
	a.DtOc("tuːg");
	a.DtOc("sluːwɢ");
	a.DtOc("sluːg");
	a.Ptl(b=>{
		b.聲符("叔");
		b.諧聲域("TUK");
		b.反切("冬毒");
		b.中古地位("端沃一入");
