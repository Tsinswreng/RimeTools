Z("弭", a=>{
	a.PolyMc("mjex");
	a.BsOc(b=>{
		b.Oc("*[m-ŋ]e(j)ʔ");
		b.Gloss("bow decorated with bone or ivory ends");
	});
	a.SchOc("meʔ");
	a.MsoegOc("mɛʔ");
	a.DtOc("mniʔ");
	a.Ptl(b=>{
		b.聲符("弭");
		b.諧聲域("ME");
		b.反切("綿婢");
		b.中古地位("明支三A上");
		b.切拼("mieq");
		b.上古音參考("meʔ");
		b.考釋("·弭，《說文》：「弭，弓無緣，可以解轡紛者。从弓，耳聲。𢏱，弭或从兒。」「耳」在之部，與支部「弭」字不諧，非聲。張富海謂其字从「弓」从「耳」會意（說見：張富海《利用諧聲構擬上古音應該注意的幾個問題》），可疑。古文字的「弭」大概本是一個爲古漢語｛弭｝*meʔ造的整體表意字，象末端有裝飾的弓形，後上端裝飾脫落（字形參考《集成》02780），而類化爲「耳」形。");
	});
	a.廣韻意("弓末又息也亦無縁弓也");
});
