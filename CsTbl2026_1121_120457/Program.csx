Z("㠑", a=>{
	a.PolyMc("zuaix");
	a.PolyMc("zyix");
	a.Ptl(b=>{
		b.聲符("罪");
		b.諧聲域("TSUI");
		b.反切("徂賄");
		b.中古地位("從灰合一上");
		b.切拼("dzojq");
		b.上古音參考("dzˤuiʔ");
		b.考釋("·罪，《說文》：「罪，捕魚竹网。从网、非。秦以罪爲辠字。」段玉裁改作「从网，非聲」，注云：「『聲』字舊缺，今補。本形聲之字。始皇改爲會意字也。徂賄切。十五部。」其意謂先有「非」聲之「罪」（因補「聲」字）、而後有始皇帝易「辠」之爲「罪」，則有二字。然段氏所謂形聲者無徵，似不必。今人或徑說「罪」爲「非」聲，不察其聲韻之不合，謬矣。");
	});
	a.Ptl(b=>{
		b.聲符("罪");
		b.諧聲域("TSUI");
		b.反切("徂累");
		b.中古地位("從脂合三上");
		b.切拼("dzwiq");
	});
	a.廣韻意("𡻭㠑山皃徂累切一");
	a.廣韻意("𡼊㠑山皃");
});
