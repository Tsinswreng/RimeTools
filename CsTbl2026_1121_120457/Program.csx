Z("𧀥", a=>{
	a.PolyMc("qiu");
	a.Ptl(b=>{
		b.聲符("㥑");
		b.諧聲域("ɁU");
		b.反切("於求");
		b.中古地位("影尤三平");
		b.切拼("qu");
		b.上古音參考("ʔ(r)u");
		b.考釋("·憂，《說文》：「憂，和之行也。从夊，𢝊聲。《詩》曰：『布政憂憂。』」《說文》：「𢝊，愁也。从心从頁。」按：《說文》之說不可信。李運富指出古文字「頁」「首」音義尚未分化，「𢝊」所从的「頁」讀幽部音、應該是聲符（說見：李運富《楚國簡帛文字構形系統研究》、裘錫圭《從殷墟卜辭的“王占曰”說到上古漢語的宵談對轉》），其說具有啟發性。然讀LU的「頁（首）」與「𢝊」ɁU聲紐迥異，恐不能自然諧聲。也許「頁（首）」聲的「𢝊」本來應讀｛怞｝（同源詞如｛陶｝｛妯｝｛軸｝｛㾄｝等）一類表示“憂病”的詞，後訓讀｛憂｝（與｛怮｝同源）；抑或｛𢝊｝的聲母本有流音成分，與LU音近（秦駰玉版「永戁(歎)憂盩(怞)」仍爲同源詞連用？），後爲影母*ʔ-。未詳。");
	});
	a.廣韻意("菜名");
});
