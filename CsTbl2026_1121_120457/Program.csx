		b.反切("耳由");
		b.中古地位("日尤三平");
		b.切拼("nju");
		b.上古音參考("nu");
		b.考釋("·柔，《說文》：「柔，說文木曲直也。从木、矛聲。」許慎謂「柔」爲「矛」聲，音韻學家舊或以此爲N~M交替，實非。商代晚期金文（《集成》06926）有一獨體象形字，用爲專名、無義可考，或釋爲「柔」；西周晚期召伯簋（《集成》04293）見以其爲聲、从「言」之字，李學勤釋「𫍅」、讀爲｛擾｝，文從字順，可見前述殷金文沒有問題爲「柔」。早期「柔」乃整體表意字，構字本義待考，東周時期上部類化爲「矛」（也有與「矛」音近的成分，即變形音化），遂作「柔」之形。·𨛶，蓋「𨜙」之誤字。《集韻》：「𨛶，鄉名。或作𨜙。」");
	});
	a.Ptl(b=>{
		b.聲符("柔");
		b.諧聲域("NU");
		b.反切("人九");
		b.中古地位("日尤三上");
		b.切拼("njuq");
		b.上古音參考("nuʔ");
	});
	a.廣韻意("香葇菜");
	a.廣韻意("葇䖆菜不切也");
});
