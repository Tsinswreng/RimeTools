Z("𠨜", a=>{
	a.PolyMc("nguot");
	a.Ptl(b=>{
		b.聲符("元");
		b.諧聲域("KON");
		b.反切("五忽");
		b.中古地位("疑沒合一入");
		b.切拼("ngot");
		b.上古音參考("ŋˤut");
		b.考釋("·兀，裘錫圭先生謂傳世文字系統的「兀」有兩個來源，一是「元」的變體；一是由甲骨文中釋爲｛刖｝之字的一刖足人形訛變而成（說見：裘錫圭《甲骨文中所見的商代五刑－並釋“𠚯”“剢”》）。但是他所分的後者迄今仍無殷商與秦漢之間的兩周字形材料，其說恐不可信。");
	});
