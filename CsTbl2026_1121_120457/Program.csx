Z("戴", a=>{
	a.TswgOcModed("tˁəks", b=>{
		b.Note("bs 廣韻聲形考: 戠省聲");
	});
	a.PolyMc("taih");
	a.BsOc(b=>{
		b.Oc("*Cə.tˤək-s");
		b.Gloss("carry on the head");
	});
	a.SchOc("tə̂h");
	a.MsoegOc("tˁəh");
	a.DtOc("ʔl'ɯːgs");
	a.Ptl(b=>{
		b.聲符("戠");
		b.諧聲域("TƏK");
		b.反切("都代");
		b.中古地位("端咍開一去");
		b.切拼("teojh");
		b.上古音參考("tˤəkh");
		b.考釋("·戴，《說文》云「𢦔」聲，聲紐不合，不可信。「戴」似爲「戠」省聲。上博竹書二《容成氏》簡9「履地△天」之「△」即从「首」、「戠」省聲，或說从「弋」、非，「戈」上一橫可爲證，楚系「戠」（如《包山》18）即如此，其省去了右下部以置放義符「首」，清華二簡20有不省者。秦漢文字「戴」字來源類此，其形體沿襲自早期｛戴｝初文「異(戴)」加注「戠」聲之字，後「戠」聲省形、類化爲「𢦏」，遂作「戴」。");
	});
	a.廣韻意("荷戴又姓出濟比本自宋戴穆公之後風俗通云凡氏於諡戴武宣穆是也都代切一");
});
