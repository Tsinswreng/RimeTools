Z("片", a=>{
	a.PolyMc("phenh");
	a.BsOc(b=>{
		b.Oc("*pʰˤe[n]-s");
		b.Gloss("half; partial");
	});
	a.SchOc("pʰêns");
	a.SchOc("pʰâns");
	a.MsoegOc("pʰˁɛnh");
	a.DtOc("pʰeːns");
	a.Ptl(b=>{
		b.聲符("片");
		b.諧聲域("PEN");
		b.反切("普麵");
		b.中古地位("滂先四去");
		b.切拼("phenh");
		b.上古音參考("pʰˤenh");
		b.考釋("·片，从半「木」。古今文字系統中作半「木」之形者有至少兩組確定來源不同的讀音：①精組錫部TSEK，爲「𣂔(析)」之省形，一般釋寫作「𰀠」，戰國秦漢文字「𥫪(策)」、漢碑「㭊」皆以之爲聲。馬王堆帛書《老子》乙本：「善數者不以檮(籌)𥫪(策)。241」甲本：「善數者不以檮𥮥。」今王弼本作「善數者無籌策」。石鼓文《田車》：「𨖍(吾)㠯(以)𨹷(躋)于邍(原)。」漢代張遷碑：「陽氣厥㭊(析)，感思舊君。」②幫組元部，細審之亦可分爲兩類。其詞與｛辨｝-EN或｛判｝-AN同源。《說文·片部》：「片，判木也。」《論語·顏淵》：「片言可以折獄者，其由也與？」何晏集解引孔安國：「片，猶偏也。」陸德明釋文：「片，如字。鄭云：半也。」《莊子·則陽》「雌雄片合於是庸有。」陸德明釋文：「片，音判，又如字。」《釋文》所謂如字，是以霰韻phenh音爲正，音判phanh者別一讀。切韻聲系中二音同出，「沜」普半切乃以後者爲聲。");
	});
	a.廣韻意("半也判也析木也普麵切三");
});
