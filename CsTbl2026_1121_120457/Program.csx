Z("銼", a=>{
	a.PolyMc("chuah");
	a.PolyMc("zua");
	a.PolyMc("zuk");
	a.DtOc("shoːls");
	a.DtOc("zoːl");
	a.DtOc("zoːg");
	a.Ptl(b=>{
		b.聲符("坐");
		b.諧聲域("TSOI");
		b.記號("<");
		b.反切("作木");
		b.中古地位("精歌合一平");
		b.切拼("dzwa");
		b.考釋("·鎐，姓也，其望出彭城。「鎐」字作「䍃」旁，與其聲不合。楊寶忠謂此爲「銼」之訛字，將毒切「錊」亦然（說見：楊寶忠《疑難字續考》P306），可從；唯楊氏謂「銼」爲「鏃」之聲符更易字，似未審韻尾之殊別，「坐」「族」二者不爲可換聲符。審諸書皆言其姓讀屋沃韻（中古盛唐以後已不分屋沃），與「坐」聲不諧，甚可怪。以「銼」考之，疑早期姓氏書所注反切下字本作「禾」、誤爲「木」，後遂誤收入《屋韻》，所謂「音鏃」、「將毒切」者皆襲其誤而作矣，是「銼」（昨木切）、「鎐」（作木切）、「錊」（將毒(木)切）三字讀音當並正。");
	});
	a.Ptl(b=>{
		b.聲符("坐");
		b.諧聲域("TSOI");
		b.記號("<");
		b.反切("將毒(木)");
		b.中古地位("精歌合一平");
		b.切拼("dzwa");
		b.考釋("·錊，姓也，見昨木切「鎐」字下。");
	});
	a.Ptl(b=>{
		b.聲符("坐");
		b.諧聲域("TSOI");
		b.反切("麤卧");
		b.中古地位("清歌合一去");
		b.切拼("tshwah");
	});
	a.Ptl(b=>{
		b.聲符("坐");
		b.諧聲域("TSOI");
		b.反切("昨禾");
		b.中古地位("從歌合一平");
		b.切拼("dzwa");
		b.上古音參考("dzˤoi");
	});
	a.Ptl(b=>{
		b.聲符("坐");
		b.諧聲域("TSOI");
		b.反切("昨木");
		b.中古地位("從歌合一平");
		b.切拼("dzwa");
		b.考釋("·銼，見昨木切「鎐」字下。");
	});
