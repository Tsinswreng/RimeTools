Z("囏", a=>{
	a.PolyMc("kren");
	a.BsOc(b=>{
		b.Oc("*kˤrə[r]");
		b.Gloss("distress, difficulty");
	});
	a.MsoegOc("kʴˁən");
	a.DtOc("krɯːn");
	a.Ptl(b=>{
		b.聲符("堇");
		b.諧聲域("KƏN");
		b.反切("古閑");
		b.中古地位("見山開二平");
		b.切拼("keen");
		b.上古音參考("krˤən");
		b.考釋("·囏，又作「艱」。《說文》：「𥌵，土難治也。从堇、艮聲。囏，籒文艱从喜。」甲骨文「㛸」、「⿰壴卩」讀爲｛艱｝，象人跪坐守鼓之形，是｛艱｝的表意字，所从「壴」非聲（說見：郭沫若《卜辭通纂》、陳劍《殷墟卜辭的分期分類對甲骨文考釋的重要性》）；其異體作「⿰𦰩壴」，乃「𦰩」聲，《說文》籀文「囏」即此字加「口」而作（說見：陳劍上引文、孫俊,趙鵬《“艱”字補釋》）。張富海以爲「𦰩」象縛手呼號之人，表示艱難之意，既可讀爲｛艱｝、也可以讀爲｛難｝（說見：張富海《說“難”》），故兼有見組文部KƏN、泥組元部NAN兩類讀音；前者在傳世文字系統中作「堇」聲，後者保留在「難」等字中。");
	});
	a.廣韻意("古文");
});
