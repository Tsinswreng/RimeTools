Z("強", a=>{
	a.PolyMc("giang");
	a.Ptl(b=>{
		b.聲符("𪪺");
		b.諧聲域("KAŊ");
		b.反切("巨良");
		b.中古地位("羣陽開三平");
		b.切拼("gyang");
		b.上古音參考("ɡaŋ");
		b.考釋("·強，《說文》：「強，蚚也。从虫、弘聲。𧖑，籒文强，从䖵从彊。」徐鍇曰：「『弘』與『強』聲不相近，秦刻石文从口，疑从籀文省。」徐鍇謂「𪪺」爲「彊」之省無據，然謂「『弘』與『強』聲不相近」是也；裘錫圭先生以爲甲骨文「𪪺」从「口」从「弓」，張「弓」需要很強的力，乃以「口」抽象出“強”的意義，「𪪺」是｛強｝*ɡaŋ之表意字、與「弘」同形而異源。說見：裘錫圭《釋“弘”“強”》。");
	});
	a.廣韻意("健也暴也說文曰蚚也又姓後漢有強華奉赤伏符巨良切四");
});
