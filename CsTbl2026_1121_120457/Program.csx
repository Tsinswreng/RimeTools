Z("䜅", a=>{
	a.PolyMc("chu");
	a.PolyMc("jyi");
	a.PolyMc("zjyi");
	a.Ptl(b=>{
		b.聲符("崔");
		b.諧聲域("TSUI");
		b.反切("千侯");
		b.中古地位("精脂合三平");
		b.切拼("tswi");
		b.上古音參考("tsui");
		b.考釋("·䜅，就也。《毛詩·邶風·北門》：「室人交徧摧我。」陸德明釋文：「摧，徂回反，沮也。或作催，音同。《韓詩》作『䜅』，音于隹、子隹二反，就也。」《廣雅·釋詁三》：「䜅，就也。」《名義》千隹反；《玉篇》以隹、十惟二切；《廣雅音註》子佳〔反〕；《王三》以隹(又十隹反)、千侯(又于隹反)二反；《廣韻》以追(又十隹切)、視隹(又以隹切)、千侯三切。按「䜅」乃「崔」聲，出《韓詩》，《毛詩》作「摧」、《說文》引《詩》作「催」，上古音無疑當在合口微部精組TSUI附近，由是可考中古諸音之不可信：①千侯切，其韻母與諧聲不合，該小韻只此一字，《王三》置於幽韻末，可怪。中古「侯」「隹」形近，「侯」爲「隹」之訛字（說見：葛信益《〈廣韻〉訛奪舉正（增定稿）》），《切韻》系韻書據他書收錄此切。②視隹切，其聲母與諧聲不合，《王三》視隹切無此字，當是《廣韻》據以隹切下又音「十隹反」增，然此類切語上字「十」似本爲「千」之訛字。由是誤讀常母，與「誰脽」同音。③于隹反，《釋文》有「于隹、子隹二反」，前者云母與諧聲不合，是誤自上字「千」之訛，此正誤同出。④以追切，其聲母可疑，趙少咸疑本自前已誤之「于隹反」（說見：趙少咸《廣韻疏證》），似非，切韻云母、以母後雖合流入喻母，然其反切尚有別、不相錯雜。察此音與「惟維濰蓶琟唯」同音，或爲望形誤讀。");
	});
	a.Ptl(b=>{
		b.聲符("崔");
		b.諧聲域("TSUI");
		b.反切("視(十)隹");
		b.中古地位("精脂合三平");
		b.切拼("tswi");
		b.上古音參考("tsui");
		b.考釋("·䜅，見千侯切之「䜅」。");
	});
	a.Ptl(b=>{
		b.聲符("崔");
		b.諧聲域("TSUI");
		b.反切("以追");
		b.中古地位("以脂合三平");
		b.切拼("jwi");
		b.考釋("·䜅，見千侯切之「䜅」。");
	});
	a.廣韻意("就也又[士/十]隹切");
	a.廣韻意("就也又以隹切");
	a.廣韻意("就也千侯切一");
});
