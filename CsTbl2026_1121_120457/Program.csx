Z("㡿", a=>{
	a.PolyMc("chjek");
	a.BsOc(b=>{
		b.Oc("*t-qʰAk");
		b.Gloss("salty soil");
	});
	a.SchOc("k-l̥ak");
	a.MsoegOc("ʰɫak");
	a.Ptl(b=>{
		b.聲符("乇");
		b.諧聲域("TAK");
		b.反切("昌石");
		b.中古地位("昌昔開三入");
		b.切拼("tjhiaek");
		b.上古音參考("tʰak");
		b.考釋("·尺，疑爲「厇」之分化字。·斥，《說文》無「斥」字，清人多謂爲「㡿」之俗字，《說文》：「㡿，郤屋也。从广、屰聲。」段玉裁注：「俗作厈、作斥。幾不成字。」近人說「斥」爲「㡯」之分化字，「㡿」爲訛形（參考：何琳儀《古璽雜識續》、季旭昇《說文新證》2014版P724-725）。兩說各得其半，後世所謂「斥」之部件本有兩個來源：一者爲「㡿」之分化字、係「屰」聲，古音在疑組鐸部ŊAK，「訴」「泝」屬此類。秦簡有「㡿」字讀爲｛訴｝，睡虎地秦簡《語書》：「是以善㡿(訴)事11」；另一者爲「㡯」之分化字、係「乇」聲，古音在端組鐸部TAK，「斥」「坼」屬此類。東漢許慎作《說文》已不察其別。中古小學家不知「斥(㡿)」「斥(㡯)」之別，遂誤讀「㡿」爲昌母音。");
	});
	a.廣韻意("逐也逺也又㡿候說文曰卻[行/屋]也从广屰屰音逆");
});
