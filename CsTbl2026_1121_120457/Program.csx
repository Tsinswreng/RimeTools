Z("逑", a=>{
	a.PolyMc("giu");
	a.BsOc(b=>{
		b.Oc("*g(r)u");
		b.Gloss("come together; mate (n.)");
	});
	a.SchOc("gu");
	a.MsoegOc("gu");
	a.StaOc("ɡ⁽ʱ⁾u");
	a.DtOc("gu");
	a.Ptl(b=>{
		b.聲符("求");
		b.諧聲域("KU");
		b.反切("巨鳩");
		b.中古地位("羣尤三平");
		b.切拼("gu");
		b.上古音參考("ɡu");
		b.考釋("·求，傳世文字系統的「求」有兩個來源：一爲一般的「求」，裘錫圭先生以爲｛𧒔｝之初文（說見：裘錫圭《釋“求”》）；一爲陳劍先生所釋「逑」之聲首（說見：陳劍《據郭店簡釋讀西周金文一例》）。二者形音皆近，故混而一。");
	});
	a.廣韻意("匹也");
});
