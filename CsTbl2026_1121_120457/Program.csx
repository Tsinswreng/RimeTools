Z("漿", a=>{
	a.TswgOcModed("tsaŋ");
	a.TswgOcModed("stˁaŋ", b=>{
		b.Note("ts");
	});
	a.PolyMc("ciang");
	a.BsOc(b=>{
		b.Oc("*[ts]aŋ");
		b.Gloss("drink (n.)");
	});
	a.SchOc("tsaŋ");
	a.MsoegOc("tʃaŋ");
	a.StaOc("tɕaŋ");
	a.DtOc("ʔsaŋ");
	a.Ptl(b=>{
		b.聲符("爿");
		b.諧聲域("TSAŊ");
		b.反切("即良");
		b.中古地位("精陽開三平");
		b.切拼("tsyang");
		b.上古音參考("tsaŋ");
		b.考釋("·將，其右旁「𢌳」亦爲聲首，雙手奉肉，乃“奉將”之｛將｝的初文；加注「爿」聲而作「將」。參考：王子楊《釋甲骨金文中的“將”——兼說古文字“將”之流變》。");
	});
	a.廣韻意("漿水");
});
