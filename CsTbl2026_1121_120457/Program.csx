Z("蒯", a=>{
	a.TswgOcModed("kʰrˁuts");
	a.PolyMc("khruaih");
	a.BsOc(b=>{
		b.Oc("*kʰˤru[t]-s");
		b.Gloss("a kind of rush");
	});
	a.SchOc("kʰrûs");
	a.SchOc("kʰrûts");
	a.MsoegOc("kʰ[wʴˁə]θ");
	a.DtOc("kʰruːds");
	a.Ptl(b=>{
		b.聲符("㕟");
		b.諧聲域("KUT");
		b.反切("苦怪");
		b.中古地位("溪皆合二去");
		b.切拼("khweejh");
		b.上古音參考("kʰrˤuth");
		b.考釋("·蒯，本「𠜐」聲，左下部隸變作「朋」旁（說見：鄔可晶《說金文“䝳”及相關之字》）。·㕟，陳劍先生疑「㕟」「㕢」同諧聲（說見：陳劍《釋“琮”及相關諸字》），聲韻不合，非。古文字有一字作从「歺」从「井」或「凵」，王子楊據《說文》「𠭘」上推釋「𠭘(阱)」（說見：王子楊《釋甲骨文中的“阱”字》）；陳劍先生在細審秦文字「㕟」左下明確分作「歺」與「井」後，指出甲骨文此字“應改釋爲「㕟」還是承認仍係「𠭘/𠭗(阱)」、與「㕟」僅爲同形關係，尚待研究”（見：陳劍《簡談清華簡〈四告〉的“㕟”字省體》）。紀帥謂其字當既可音“掘井”之｛掘｝、又可音｛阱｝（說見：紀帥《釋甲骨文中“𠃊（牆垣）”旁及相關諸字——兼說甲骨文中的“墾田”和“掘阱”》），其說甚善。是傳世文字「㕟」KUT爲｛掘｝*ɡut（“掘井”）的表意字之流變。");
	});
	a.廣韻意("茅類又姓出襄陽漢有蒯通或作𦰵苦怪切九");
});
