Z("㨝", a=>{
	a.PolyMc("set");
	a.Ptl(b=>{
		b.聲符("𬌍");
		b.諧聲域("LIK");
		b.反切("先結");
		b.中古地位("心屑開四入");
		b.切拼("set");
		b.上古音參考("ɬˤik");
		b.考釋("·屑，《說文》：「㞕，動作切切也。从尸，䏌聲。」其所謂聲符「䏌」於古無徵，蓋自「㞕」「佾」上剝離而來，不可信。陳劍先生認爲源自「𬌍」中「⿱兔月」之流變，說見：陳劍《甲骨金文舊釋“䵼”之字及相關諸字新釋》。今從其說。秦文字似多將各種不同來源的部件類化爲「尸」形，「屋」「履」等皆如此。");
	});
	a.廣韻意("揲㨝");
});
