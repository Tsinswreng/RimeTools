Z("倄", a=>{
	a.PolyMc("ghrau");
	a.PolyMc("i'uaix");
	a.DtOc("ɢraːw");
	a.DtOc("ɢʷɯːʔ");
	a.Ptl(b=>{
		b.聲符("又");
		b.諧聲域("WƏ");
		b.反切("于罪");
		b.中古地位("云廢合三上");
		b.切拼("uojq");
		b.考釋("·倄，「侑」之訛字，痛叫、痛聲，或又作「痏」。《顏氏家訓·風操》：「《蒼頡篇》有『倄』字，《訓詁》云：『痛而謼也，音羽罪反。』今北人痛則呼之。《聲類》音于來反，今南人痛或呼之。」《說文》：「倄，剌也。从人、肴聲。{一曰痛聲。}」段玉裁注：「玄應《佛書音義》曰：『痏痏，諸書作「侑」。《通俗文》：于罪切。痛聲曰痏。』此條合之字義、俗語皆無不合。其云『諸書作侑』，葢《蒼頡訓詁》亦在其中。借『侑』爲『痏』，皆『有』聲也。《顏氏家訓》之『倄』當是『侑』之誤。不必與《說文》牽合。大徐《說文》改『毒之』爲『痛聲』，恐是竊取黃門語。」其說改《顏氏家訓》羽罪反之「倄」爲「侑」可從；改《說文》則未必。前人多已言及，「肴」聲之字不得音賄韻，《廣韻》于罪切之字實作「侑」，是也。此字後訛作「倄」，與原本胡茅切、同樣與“痛”有關的「倄」相混。");
	});
	a.Ptl(b=>{
		b.聲符("爻¹");
		b.諧聲域("KAU");
		b.反切("胡茅");
		b.中古地位("匣肴開二平");
		b.切拼("ghaew");
		b.上古音參考("ɡrˤau");
	});
	a.廣韻意("痛聲");
	a.廣韻意("痛而叫也于罪切一");
});
