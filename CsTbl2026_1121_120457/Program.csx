	a.BsOc(b=>{
		b.Oc("*[ts]ek");
		b.Gloss("spine, backbone");
	});
	a.SchOc("tsek");
	a.SchOc("dzek");
	a.MsoegOc("[ts]ɛk");
	a.DtOc("ʔseg");
	a.Ptl(b=>{
		b.聲符("脊");
		b.諧聲域("TSEK");
		b.反切("資昔");
		b.中古地位("精昔開三入");
		b.切拼("tsiaek");
		b.上古音參考("tsek");
		b.考釋("·脊，或說上本「朿」聲（說見：劉釗《〈說文解字〉匡謬(四則)》），非。參見：鄔可晶《說“脊”、“骴”》。");
	});
	a.廣韻意("背脊釋名曰脊積也積續骨節終上下也說文作𦟝背呂也");
});
