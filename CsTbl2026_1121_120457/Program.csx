Z("叔", a=>{
	a.TswgOcModed("stiwk");
	a.PolyMc("sjuk");
	a.BsOc(b=>{
		b.Oc("*s-tiwk");
		b.Gloss("gather, harvest");
	});
	a.BsOc(b=>{
		b.Oc("*s-tiwk");
		b.Gloss("3rd of 4 brothers");
	});
	a.SchOc("n̥uk");
	a.MsoegOc("[l̥]uk");
	a.MsoegOc("[l̥]uk");
	a.DtOc("hljɯwɢ");
	a.Ptl(b=>{
		b.聲符("叔");
		b.諧聲域("TUK");
		b.反切("式竹");
		b.中古地位("書屋三入");
		b.切拼("sjuk");
		b.上古音參考("st(i)uk");
		b.考釋("·尗，《說文》：「尗，豆也。象尗豆生之形也。」《說文》以「叔」爲「尗」聲，然古文字「叔」實爲表意字，象以手持杙植於土之形（參考：裘錫圭《釋“弋”》、謝明文《釋甲骨文中的“叔”字》）。字書中的「尗」蓋小學家剝離自「叔」字而附會｛菽｝詞所得，來源不古。傳世系統中的「尗」「叔」聲字有兩個不同的來源（說見：施瑞峰《試論“尗”聲系及相關字詞的離析》未刊稿）：一者爲前述表意字「叔」，古音在端組幽部TUK；另一者見《集成》02012（參考：裘錫圭《戎生編鐘銘文考釋》），古音在精組幽部TSIUK，秦漢時期「叔」左旁與後者合流作「尗」形。");
	});
	a.廣韻意("季父亦姓左傳魯公子叔弓之後光武破虜將軍叔壽又漢複姓二氏後漢有犍爲叔先雄左傳魯有大夫叔仲小式竹切十三");
});
