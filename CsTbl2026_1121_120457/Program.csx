Z("巵", a=>{
	a.PolyMc("cje");
	a.DtOc("tje");
	a.Ptl(b=>{
		b.聲符("枳");
		b.諧聲域("KE");
		b.反切("章移");
		b.中古地位("章支開三平");
		b.切拼("tjie");
		b.上古音參考("ke");
		b.考釋("·巵，《說文》：「巵，圜器也。一名觛。所以節飲食。象人，卪在其下也。《易》曰：君子節飲食。」所謂「象人，卪在其下也」不可信。戰國文字「只」除去「口」的下部似F形，我頗疑「卮」从「卩」、「只」省聲。秦漢文字材料中｛卮｝亦作「𣏌」、「栀」（參考：李家浩《〈易林〉校勘一得──兼談江陵鳳凰山漢簡中的“𣏌”字》），是亦「枳」省聲，唯所省不同耳。");
	});
	a.廣韻意("酒器");
});
