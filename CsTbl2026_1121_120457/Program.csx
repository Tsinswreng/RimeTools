Z("䵽", a=>{
	a.PolyMc("chap");
	a.Ptl(b=>{
		b.聲符("合");
		b.諧聲域("TƏP");
		b.反切("倉雜");
		b.中古地位("清盍開一入");
		b.切拼("tshap");
		b.考釋("·䵽，鼓聲，又作「𩌇」、「𪔕」。《說文》：「𪔕，鼓鼙聲。从鼓，缶聲。」段玉裁注：「按『缶』聲不得土盍切明矣。《玉篇》曰：『䵽，𡔷聲也。七盍切。』《廣韵》曰：『䵽，𡔷聲也。倉雜切。』皆卽其字。『缶』者，『去』之譌，『去』聲古或入侵部也。然皆『䶀』之誤字耳。」其說可從。然《名義》恥闔反與「合」聲相諧，《切韻》系韻書及《玉篇》讀清母、與字形不合，未詳。");
	});
	a.廣韻意("鼓聲");
});
