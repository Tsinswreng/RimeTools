Z("醫", a=>{
	a.PolyMc("qi");
	a.SchOc("ʔə");
	a.DtOc("qɯ");
	a.Ptl(b=>{
		b.聲符("医");
		b.諧聲域("ɁI");
		b.反切("於其");
		b.中古地位("影之開三平");
		b.切拼("qy");
		b.上古音參考("ʔǝ");
		b.考釋("·醫，《說文》：「醫，治病工也。殹，惡姿也；醫之性然。得酒而使，从酉。王育說。一曰殹，病聲。酒所以治病也。《周禮》有醫酒。古者巫彭初作醫。」其說曲折，王筠《句讀》：「从酉、殹聲，不須委曲說以會意也。」說較簡明。然「醫」在上古之部，與脂部「殹」聲不合，段玉裁《注》謂此字「古音在一部，與『翳、鷖』字在十五部不同」即此。段氏古音精審，因主會意之說。然會意實難信從，恐形聲爲是，其韻部之異或許與秦文字語气詞用字「殹」的虛化有關。「醫酒」者別一詞，字又作「臆」，未詳。");
	});
	a.廣韻意("醫療也亦官名漢太常屬官有太醫令續漢書曰秩六百石有藥丞主藥方說文曰巫彭初作醫於其切五");
});
