		b.諧聲域("WAN");
		b.反切("況袁");
		b.中古地位("曉元合三平");
		b.切拼("huon");
		b.上古音參考("w̥an");
		b.考釋("·吅，傳統小學家一般以爲「讙」之異體，从二「口」會意。《說文》：「吅，驚嘑也。从二口。凡吅之屬皆从吅。讀若讙。」原本《玉篇》：「吅，詡煩反。《說文》：『驚呼也。』《聲類》：『此古文讙字也。』」從古文字材料看，「雚」本「雈」聲，其二「口」是分化符號或義符；傳世「吅」字是自「雚」上剝離產生的。");
	});
	a.廣韻意("喚聲又私全切");
	a.廣韻意("爭言也出文字音義又宣喧二音");
});
