Z("㑉", a=>{
	a.PolyMc("siuk");
	a.Ptl(b=>{
		b.聲符("夙");
		b.諧聲域("SUK");
		b.反切("息逐");
		b.中古地位("心屋三入");
		b.切拼("suk");
		b.上古音參考("suk");
		b.考釋("·夙，《說文》：「𡖊(夙)，早敬也。从丮，持事；雖夕不休：早敬者也。」陳劍先生以爲甲骨文中的「丮」有｛祝｝音，「孰」「夙」皆「丮」聲；謝明文據西周金文“夙夜”之｛夙｝作「丮」，謂「丮」有｛夙｝音（說見：謝明文《說夙及其相關之字》），說皆有理。然「孰」TUK、「夙」SUK聲母迥異，不可混爲一談。待考。");
	});
	a.廣韻意("傗㑉不伸");
});
