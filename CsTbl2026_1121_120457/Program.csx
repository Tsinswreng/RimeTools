Z("穿", a=>{
	a.TswgOcModed("tʰon");
	a.PolyMc("chjyen");
	a.PolyMc("chjyenh");
	a.BsOc(b=>{
		b.Oc("*tʰo[n]");
		b.Gloss("bore through");
	});
	a.SchOc("tʰon");
	a.MsoegOc("ʰɫɔn");
	a.DtOc("kʰljon");
	a.DtOc("kʰljons");
	a.Ptl(b=>{
		b.聲符("穿");
		b.諧聲域("KLON");
		b.反切("昌緣");
		b.中古地位("昌仙合三平");
		b.切拼("tjhwien");
		b.上古音參考("kʰlon");
		b.考釋("·穿，｛貫｝｛穿｝爲一組上古漢語同源詞。戰國楚簡中｛穿｝寫作「⿰耳串」，从「耳」、「串」聲。安大竹簡一《詩經》：「可(何)㠯(以)△(穿)我𦤿(屋)？29」今本《毛詩·召南·行露》作「何以穿我屋」。余疑秦漢文字「穿」字蓋「⿰耳串」省聲，在演變中省去聲素「串」，又將「耳」訛作「牙」（秦漢文字「耳」「牙」形近易混訛，猶「邪」分化出「耶」），遂作「穿」字。待考。");
	});
	a.Ptl(b=>{
		b.聲符("穿");
		b.諧聲域("KLON");
		b.反切("尺絹");
		b.中古地位("昌仙合三去");
		b.切拼("tjhwienh");
		b.上古音參考("kʰlonh");
	});
	a.廣韻意("通也孔也昌縁切三");
	a.廣韻意("貫也又音川");
});
