	a.DtOc("qromʔ");
	a.Ptl(b=>{
		b.聲符("甲");
		b.諧聲域("ɁAM");
		b.反切("衣儉");
		b.中古地位("影鹽開三B上");
		b.切拼("qyemq");
		b.上古音參考("ʔramʔ");
		b.考釋("·奄，古文字作「甲」聲，訛變作「申」形。說見：陳劍《說“規”等字并論一些特別的形聲字意符》。·𣃳，疑爲「掩」之訛變分化字，古書中「扌」「方」易混，「𠂉」當爲「奄」上「大」之訛形。或又訛作「𣄉」、「𣃰」。《廣韻》中此三字皆“掩翳”義，是來自「掩」。又有“網”義，同「罨」，《名義》：「𣄑，扵業反。率。网。」其「𣄑」當爲累疊字形。後因與「㘝」音義俱近，遂將「奄」下部改作形近的「㘝」而作「𣃳」。《廣雅》：「㘝、𣃳，率也。」");
	});
	a.Ptl(b=>{
		b.聲符("甲");
		b.諧聲域("ɁAP");
		b.反切("衣儉");
		b.中古地位("影鹽開三B上");
		b.切拼("qyemq");
		b.上古音參考("ʔramʔ");
		b.考釋("·奄，古文字作「甲」聲，訛變作「申」形。說見：陳劍《說“規”等字并論一些特別的形聲字意符》。·𣃳，疑爲「掩」之訛變分化字，古書中「扌」「方」易混，「𠂉」當爲「奄」上「大」之訛形。或又訛作「𣄉」、「𣃰」。《廣韻》中此三字皆“掩翳”義，是來自「掩」。又有“網”義，同「罨」，《名義》：「𣄑，扵業反。率。网。」其「𣄑」當爲累疊字形。後因與「㘝」音義俱近，遂將「奄」下部改作形近的「㘝」而作「𣃳」。《廣雅》：「㘝、𣃳，率也。」");
	});
