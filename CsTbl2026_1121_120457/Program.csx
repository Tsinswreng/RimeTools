Z("陳", a=>{
	a.TswgOcModed("lriŋ");
	a.TswgOcModed("lrin");
	a.PolyMc("drin");
	a.PolyMc("drinh");
	a.BsOc(b=>{
		b.Oc("*lri[n]");
		b.Gloss("arrange");
	});
	a.BsOc(b=>{
		b.Oc("*lri[n]-s");
		b.Gloss("battle array");
	});
	a.SchOc("drin");
	a.SchOc("drins");
	a.MsoegOc("lʴəl");
	a.MsoegOc("lʴəlh");
	a.StaOc("dʱrin");
	a.DtOc("l'iŋ");
	a.DtOc("l'iŋs");
	a.Ptl(b=>{
		b.聲符("陳");
		b.諧聲域("LIŊ");
		b.反切("直珍");
		b.中古地位("澄真開三平");
		b.切拼("drin");
		b.上古音參考("lriŋ");
		b.考釋("·陳，《說文》：「陳，宛丘，舜後嬀滿之所封。从𨸏从木，申聲。」從古文字材料看，其說非是。古文字有一字象以手作多次纏束之形，爲“紳束”之｛紳｝*l̥iŋ的表意字（說見：裘錫圭,李家浩《談曾侯乙墓鐘磬銘文中的幾個字》），此即「敶」之聲首。");
	});
	a.Ptl(b=>{
		b.聲符("陳");
		b.諧聲域("LIŊ");
		b.反切("直刃");
		b.中古地位("澄真開三去");
		b.切拼("drinh");
		b.上古音參考("lriŋh");
	});
	a.廣韻意("陳列也張也衆也布也故也亦州名本太昊之墟畫八卦之所周武王封舜後胡公滿於陳楚滅陳爲縣漢爲淮陽國隋爲陳州又姓胡公滿之後子孫以國爲氏出潁川汝南下邳廣陵東海河南六望又虜三字姓後魏書有侯莫陳氏直珍切又直刃切五");
	a.廣韻意("上同見經典");
});
