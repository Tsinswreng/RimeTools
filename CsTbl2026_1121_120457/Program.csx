Z("𩼈", a=>{
	a.PolyMc("qauh");
	a.Ptl(b=>{
		b.聲符("奧");
		b.諧聲域("ɁUK");
		b.反切("烏到");
		b.中古地位("影豪開一去");
		b.切拼("qawh");
		b.上古音參考("ʔˤukh");
		b.考釋("·奧，《說文》：「奧，宛也。室之西南隅。从宀，𢍏聲。」徐鉉曰：「𢍏非聲，未詳。」段玉裁注：「烏到切。古音在三部。按《廾部》：『𢍏，讀若書卷』，則奥宜讀若怨。而古音不尒者，取雙聲爲聲也。」「𢍏」與「奧」韻部遠隔，非聲；段玉裁謂「取雙聲爲聲」不可信。未詳。");
	});
	a.廣韻意("小鰌名");
});
