<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Dks.Core 是「Dks 輸入法方案」專用邏輯庫，只提供代碼可調用的 API，不是 exe。
		     依賴 RimeTools 的公用域模型與接口。 -->
		<RootNamespace>Dks.Core</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- 規則數據資源(每行 pattern<TAB>replacement 或 字<TAB>音), AOT 下亦可用。 -->
		<EmbeddedResource Include="Rules/*.txt" />
	</ItemGroup>

	<ItemGroup>
		<!-- Tables/Dk.cs 是「綜合字表源」DSL 的手寫樣本：內容是 top-level 語句（Dks.Core 是 lib，
		     參與編譯會 CS8805），且 CsTbl 命令產出的 .cs＋.csproj 才是正式載體，故此檔先排除出編譯。
		     它仍留在原處供對照；日後要納入編譯，需改成 exe 專案或非 top-level 形狀。 -->
		<Compile Remove="Tables/Dk.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- RimeTools 公用域（Dict/Phrase/Freq/Tools）。 -->
		<ProjectReference Include="../RimeTools/RimeTools.csproj" />
	</ItemGroup>

	<!-- Svc 方法首參統一 IFnCtx，依賴 Tsinswreng.CsCtx（工作區本地庫）；
	     引用集中在 ../Directory.Build.props，此處不再各自寫相對路徑。 -->

</Project>