<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Dks.Core 是「Dks 輸入法方案」專用邏輯庫，只提供代碼可調用的 API，不是 exe。
		     依賴 RimeTools 的公用域模型與接口。 -->
		<RootNamespace>Dks.Core</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- 規則數據資源(每行 pattern<TAB>replacement 或 字<TAB>音), AOT 下亦可用。 -->
		<EmbeddedResource Include="Rules/*.txt" />
	</ItemGroup>

	<ItemGroup>
		<!-- RimeTools 公用域（Dict/Phrase/Freq/Tools）。 -->
		<ProjectReference Include="../RimeTools/RimeTools.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Svc 方法首參統一 IFnCtx，依賴 Tsinswreng.CsCtx（工作區本地庫）。 -->
		<ProjectReference Include="../../../Tsinswreng.CsCtx/proj/Tsinswreng.CsCtx/Tsinswreng.CsCtx.csproj" />
	</ItemGroup>

</Project>