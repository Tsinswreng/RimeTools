<Project>
	<!-- 本地庫根目錄（工作區根下的 TswgLib\）。
		 TswgLib 改名或搬家時，只改下面這一行。

		 為甚麼用 $([MSBuild]::NormalizeDirectory(...)) 而不是裸的相對路徑：
		 它把 .. 展開成絕對路徑，於是無論 MSBuild 把路徑按「這個 props 檔所在目錄」還是
		 「當前專案目錄」來解析，結果都一樣。全靠這個特性，引用它的專案不管在 proj\ 下哪一層，
		 算出來的 TswgLibsDir 都一致。

		 本檔位於 RimeTools\proj\，故 ../../ 由 proj\ 上溯兩層到工作區根，再進 TswgLib\。 -->
	<PropertyGroup>
		<TswgLibsDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../../TswgLib'))</TswgLibsDir>
	</PropertyGroup>

	<!-- 屬性值寫錯（例如 TswgLib 真被改名）時，給一句人能看懂的錯，
		 而不是讓 MSBuild 在後面拋「找不到專案」這種看不出根因的訊息。 -->
	<Target Name="ChkTswgLibsDir" BeforeTargets="PrepareForBuild">
		<Error Condition="!Exists('$(TswgLibsDir)')" Text="本地庫目錄不存在：$(TswgLibsDir)。請改 RimeTools/proj/TswgLibs.props 裏的 TswgLibsDir。" />
	</Target>
</Project>
